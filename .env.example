DATABASE_URL="postgresql://USER@HOST:5432/print_shop_erp"

# Auth.js v5: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""

# Required when deploying behind a proxy (e.g. Nginx) for Auth.js to trust the Host header
AUTH_TRUST_HOST="true"

# ===== Cron 触发用共享密钥 =====
# 受保护的 POST endpoints（POST /api/cron/daily-salary、/api/cron/hourly-payroll、
# /api/cron/cs-settle、/api/cron/generate-bills）要求 Authorization: Bearer $CRON_SECRET。
# 留空 → endpoint 返回 503，整个 cron 渠道是死路（部署时切忌漏配）。
# 生成: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 上线 / pg_cron 切换：参见 README.md 部署一节。
CRON_SECRET=""

# ===== 错误监控 (Sentry) =====
# 留空 → instrumentation.ts 不初始化 Sentry，进程零开销（dev 默认行为）。
# 设置 → 启动时自动 init server / edge SDK，未捕获的 Server Component /
# Server Action 错误经 onRequestError 上报。
# 生产建议：项目 → Settings → Client Keys (DSN) 拿到完整 DSN 字符串。
SENTRY_DSN=""
# 选填：标记 Sentry release / OTel SemanticResource，方便 trace 回溯到具体版本。
# 留空 → 'dev'。CI 用 git sha 或 package.json version 注入。
APP_VERSION=""

# ===== 企业微信推送 (lib/notification — SPEC §8) =====
# Mock-mode 行为（DECISIONS 2026-04-27）：
#   true  → 永不真发 HTTP，写 NotificationLog status=SUCCESS errorMessage='MOCK'。
#           dev / 测试默认开（NODE_ENV !== production 时也默认 true，留空即可）。
#   false → 真 fetch 企业微信 webhook URL（NotificationChannel.webhookUrl）。
# 上线必显式设置 false（README §🚢 上线 checklist 列入），否则 owner 误以为推
# 送已发。这是 prod-only 配置事故（DECISIONS 2026-04-27 论述）。
NOTIFICATION_MOCK_MODE="true"

# ===== 阿里云 OSS (设计图 / CDR 直传 — SPEC §3.1 / 附录 H) =====
# 全部必填才启用上传。任一空值 → signDesignUpload 返回
#   { status: 'not-configured', missing: [...] }
# UI 依此把上传按钮渲染成 disabled + 提示文案。不会"假成功"。
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_STS_ROLE_ARN=""
OSS_BUCKET=""
OSS_REGION=""
# 选填：覆盖默认 OSS endpoint / CDN 公网域名。留空则按 region/bucket 派生。
OSS_ENDPOINT=""
OSS_PUBLIC_BASE_URL=""

# Seed admin (prisma/seed.ts). Behavior depends on current DB state:
#   - No user with SEED_ADMIN_USERNAME exists AND no active OWNER exists:
#       SEED_ADMIN_PASSWORD set   → create OWNER with that password
#       SEED_ADMIN_PASSWORD empty → create OWNER with a printed one-time random password
#   - User with SEED_ADMIN_USERNAME exists and role=OWNER:
#       SEED_ADMIN_PASSWORD set   → reset that OWNER's password (and reactivate if isActive=false)
#       SEED_ADMIN_PASSWORD empty → skip if active; refuse if inactive (clear recovery guidance)
#   - User with SEED_ADMIN_USERNAME exists but role≠OWNER: always refuse (no silent elevation).
# Set SEED_ADMIN_PASSWORD in a secret manager for deploys; never print it to shared logs.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
