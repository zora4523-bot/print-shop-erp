DATABASE_URL="postgresql://USER@HOST:5432/print_shop_erp"

# Auth.js v5: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""

# Required when deploying behind a proxy (e.g. Nginx) for Auth.js to trust the Host header
AUTH_TRUST_HOST="true"

# 应用公网根 URL（含 protocol，无尾斜线），CDR 24h 短链拼绝对 URL 用
# （SPEC §3.5：foreman 复制链接发外协，需带 host 才能粘贴到 WeChat /
# 邮件打开）。
# **生产强烈推荐显式配置**——尤其 split-origin 部署（staff 用内网 admin
# 域、外协拿公网域）：留空时会从请求 headers 推导，foreman 在内网域
# 操作生成的链接就只能在内网访问。
# 留空（dev 默认）：action 从请求 headers (x-forwarded-proto +
#   x-forwarded-host / host) 推导。dev localhost / ngrok / 单域名生产
#   都行；split-origin 不行。
# Codex rounds 119-122。
APP_PUBLIC_URL=""

# ===== Cron 触发用共享密钥 =====
# 受保护的 8 个 POST endpoints 要求 Authorization: Bearer $CRON_SECRET：
#   /api/cron/daily-salary         师傅日薪结算
#   /api/cron/hourly-payroll       时薪工月结
#   /api/cron/cs-settle            客服周期结算扫描
#   /api/cron/generate-bills       销售应收账单生成
#   /api/cron/outsource-overdue    外协超期推送
#   /api/cron/cs-period-ending     客服周期 7 天预警
#   /api/cron/order-overdue        承诺交期逾期推送
#   /api/cron/order-export-cleanup 导出产物过期与筛选隐私清理
# 调度时区与精确时间只以 deploy/crontab.example 为准，避免多处副本漂移。
# 留空 → 8 个 endpoint 全 503，整个 cron 渠道是死路（部署时切忌漏配）。
# 生成: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 上线 / pg_cron 切换：参见 README.md 部署一节。
CRON_SECRET=""

# ===== 持久化后台任务 =====
# 生产必须是 durable：通知、cron 与 CDR 打包先入 PostgreSQL 任务账本，
# 由 PM2 的独立 light/heavy worker 执行。dev/test 留空默认 inline。
BACKGROUND_JOBS_MODE=""
# 轻任务可小并发；重任务（CDR/PDF）建议始终 1，避免 CPU/内存尖峰。
LIGHT_WORKER_CONCURRENCY="2"
HEAVY_WORKER_CONCURRENCY="1"
BACKGROUND_JOB_POLL_MS="1000"
BACKGROUND_JOB_LEASE_MS="300000"
# Web 等待 HEAVY worker 返回 PDF 的最长时间；产物目录必须对 Web/worker 共享。
PDF_JOB_WAIT_MS="10000"
PDF_ARTIFACT_DIR="/var/tmp/print-shop-erp/pdf"
# 管理员工单 XLSX 导出：Web 下载路由与 HEAVY worker 共享，
# 目录只允许运行账号访问，产物在生成完成后 24 小时过期。
ORDER_EXPORT_ARTIFACT_DIR="/var/tmp/print-shop-erp/order-exports"

# ===== 错误监控 (Sentry) =====
# 留空 → instrumentation.ts 不初始化 Sentry，进程零开销（dev 默认行为）。
# 设置 → 启动时自动 init server / edge SDK，未捕获的 Server Component /
# Server Action 错误经 onRequestError 上报。
# 生产建议：项目 → Settings → Client Keys (DSN) 拿到完整 DSN 字符串。
SENTRY_DSN=""
# 选填：标记 Sentry release / OTel SemanticResource，方便 trace 回溯到具体版本。
# 留空 → 'dev'。CI 用 git sha 或 package.json version 注入。
APP_VERSION=""

# pgBackRest 只读就绪检查所用；备份本身由 Pigsty/pgBackRest 配置执行。
PGBACKREST_STANZA=""
BACKUP_MAX_AGE_HOURS="30"
BACKUP_REQUIRED_REPOS="2"

# ===== 企业微信推送 (lib/notification — SPEC §8) =====
# Mock-mode 行为（DECISIONS 2026-04-27）：
#   留空  → 按 NODE_ENV 判定：生产（NODE_ENV=production）真发企业微信，
#           dev / 测试自动 mock。**这是推荐默认，dev 和 prod 都正确。**
#   true  → 强制 mock：永不真发 HTTP，写 NotificationLog status=SUCCESS errorMessage='MOCK'。
#   false → 强制真发 webhook URL（NotificationChannel.webhookUrl）。
# 陷阱警示：不要在模板里预置 "true"——若运维复制到生产 .env 未改，
# 推送会被静默 mock，owner 误以为急单已推送（SPEC §8 验收标准之一）。
# 故此处留空；本地开发想强制 mock 时在自己的 .env 里设 true。
NOTIFICATION_MOCK_MODE=""

# ===== 阿里云 OSS (设计图 / CDR 直传 — SPEC §3.1 / 附录 H) =====
# 全部必填才启用上传。任一空值 → signDesignUpload 返回
#   { status: 'not-configured', missing: [...] }
# UI 依此把上传按钮渲染成 disabled + 提示文案。不会"假成功"。
#
# RAM 配置要求（DECISIONS 2026-07-05）：
#   - OSS_STS_ROLE_ARN 指向的 RAM 角色挂对象读写策略
#     （design/* + bundles/* 的 PutObject/GetObject/AbortMultipartUpload/ListParts）
#   - AK 对应的 RAM 子账号需要：(a) 对该角色的 sts:AssumeRole 权限
#     （浏览器直传签发临时凭证），(b) **同一份对象读写策略直接挂在子账号上**
#     （CDR 服务端打包 + 24h 预签下载 URL 必须用长期凭证——STS 临时凭证
#     最长 1h，签不出 24h 链接）。
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_STS_ROLE_ARN=""
OSS_BUCKET=""
OSS_REGION=""
# 选填：覆盖默认 OSS endpoint / CDN 公网域名。留空则按 region/bucket 派生。
OSS_ENDPOINT=""
OSS_PUBLIC_BASE_URL=""

# CDR 打包 mock 开关（同 NOTIFICATION_MOCK_MODE 语义）：
#   留空  → 生产（NODE_ENV=production）且 OSS 配齐时真实打包；
#           非生产一律 mock（即使 .env 有真实凭证，dev/E2E 也不往真 bucket 写包）。
#   true  → 强制 mock。
#   false → 强制真实（本地要真跑打包链路时显式设；OSS 必须配齐）。
CDR_BUNDLE_MOCK_MODE=""

# Seed admin (prisma/seed.ts). Behavior depends on current DB state:
#   - No user with SEED_ADMIN_USERNAME exists AND no active ADMIN exists:
#       SEED_ADMIN_PASSWORD set   → create ADMIN with that password
#       SEED_ADMIN_PASSWORD empty → create ADMIN with a printed one-time random password
#   - User with SEED_ADMIN_USERNAME exists and role=ADMIN:
#       SEED_ADMIN_PASSWORD set   → reset that ADMIN's password (and reactivate if isActive=false)
#       SEED_ADMIN_PASSWORD empty → skip if active; refuse if inactive (clear recovery guidance)
#   - User with SEED_ADMIN_USERNAME exists but role≠ADMIN: always refuse (no silent elevation).
# Set SEED_ADMIN_PASSWORD in a secret manager for deploys; never print it to shared logs.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
