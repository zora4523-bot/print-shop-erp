DATABASE_URL="postgresql://USER@HOST:5432/print_shop_erp"

# Auth.js v5: generate with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=""

# Required when deploying behind a proxy (e.g. Nginx) for Auth.js to trust the Host header
AUTH_TRUST_HOST="true"

# Seed admin (used only on first `prisma db seed` into an empty User table).
# If SEED_ADMIN_PASSWORD is empty, the seed prints a one-time random password to stdout.
# Set explicitly in production deployments so the bootstrap credential is not in logs.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
