[Unit]
Description=ERP pgBackRest full backup repository %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=4h
StartLimitBurst=3

[Service]
Type=oneshot
User=postgres
Group=postgres
Environment=PGBACKREST_STANZA=pg-meta
Environment=PATH=/usr/pgsql/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/libexec/erp-backup/run-full-backup.sh %i
TimeoutStartSec=2h
Restart=on-failure
RestartSec=15min
Nice=10
IOSchedulingClass=idle
UMask=0077
