# Nginx 反向代理示例（红包印刷 ERP）。
#
# 用法：复制到 /etc/nginx/conf.d/print-shop-erp.conf，改 server_name 与证书路径，
#      nginx -t 测试通过后 systemctl reload nginx。
#
# 关键点（部署审计强调，漏配会静默出问题）：
#   1. 必须转发 X-Forwarded-Proto: https —— 否则 (a) 登录 cookie 的 Secure 标志失效，
#      (b) 工单打印二维码/CDR 外协短链的 base URL 推导退化成 localhost 死链。
#   2. 必须转发 Host / X-Forwarded-Host —— 二维码/短链域名跟随它。
#   3. 登录和 PDF 生成端点独立限流，避免爆破与 Chromium 资源耗尽。
#   4. CDR 生成已在 HEAVY worker 异步执行，不占 Nginx 长连接。
#
# 设计图上传是浏览器直传 OSS（不经过本服务器），所以 client_max_body_size 不需要很大；
# 20m 足够覆盖 PDF、普通表单。

# conf.d 通常被 include 在 http {} 内，因此 limit_req_zone 可放在此处。
limit_req_zone $binary_remote_addr zone=erp_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=erp_heavy:10m rate=10r/m;

# ── HTTP → HTTPS 跳转 ──
server {
    listen 80;
    server_name erp.example.com;          # ← 改成你的域名

    # Certbot webroot 续期必须在 HTTP 下直接读到挑战文件。
    # 不要把 return 301 写在 server 层，否则会在 location 匹配前就跳转。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS 主服务 ──
server {
    listen 443 ssl http2;
    server_name erp.example.com;          # ← 改成你的域名

    ssl_certificate     /etc/nginx/ssl/erp.example.com.pem;   # ← 证书路径
    ssl_certificate_key /etc/nginx/ssl/erp.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 20m;

    # Auth.js 凭据回调：严格按 IP 限流，burst 只吸收正常连点。
    location = /api/auth/callback/credentials {
        limit_req zone=erp_auth burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # PDF 仍是按需 Chromium 生成；限流避免同一来源并发压垮 Web。
    location ~ ^/api/orders/[^/]+/pdf$ {
        limit_req zone=erp_heavy burst=2 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 180s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # —— 下面 4 行是二维码/短链/cookie 正确的关键 ——
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;   # https
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP         $remote_addr;

        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout   120s;
        proxy_send_timeout   120s;
        proxy_connect_timeout 10s;
    }
}
