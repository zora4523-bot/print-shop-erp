// Prisma Schema for 红包印刷 ERP
// 版本：对应 SPEC-v1.2 冻结版
// 生成日期：2026-04-22
//
// 技术栈：
//   - Prisma 7（rust-free client，TypeScript 实现）
//   - generator 使用新的 `prisma-client` 而非旧 `prisma-client-js`
//   - 生成产物放在 ./generated/prisma/ 而非 node_modules
//   - 配合 Node.js 24 LTS 使用

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7 不再接受 datasource.url；连接 URL 由 prisma.config.ts 提供给 CLI，
// 运行时 PrismaClient 需显式传入 @prisma/adapter-pg 适配器（见 lib/db.ts、prisma/seed.ts）。
datasource db {
  provider = "postgresql"
}

// ============================================================
// 用户与权限
// ============================================================

enum Role {
  ADMIN
  SALES
  CUSTOMER_SERVICE
  WORKER
}

enum WorkerType {
  MACHINE
  PACKER
  CLEANER
  COOK
}

enum MachineType {
  HAND_PRESS // 开机仔
  WINDMILL // 风车机
  GLUE // 黏封机
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model User {
  id          String       @id @default(cuid())
  username    String       @unique @db.Citext
  password    String // bcrypt哈希
  role        Role
  workerType  WorkerType? // 仅 role=WORKER 时有值
  machineType MachineType? // 仅 workerType=MACHINE 时有值
  displayName String
  phone       String?
  avatar      String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // 关系
  submittedOrders     Order[]                     @relation("OrderSubmitter")
  createdOrders       Order[]                     @relation("OrderCreator")
  assignedTasks       ProductionTask[]
  orderLogs           OrderLog[]
  salaryPeriods       SalaryPeriod[]
  csCommissions       CustomerServiceCommission[]
  dailyWorkerSalaries DailyWorkerSalary[]
  hourlyPayrolls      HourlyWorkerPayroll[]
  attendanceRecords   Attendance[]                @relation("AttendanceWorker")
  attendanceCreated   Attendance[]                @relation("AttendanceCreator")
  bills               Bill[]
  designBundles       DesignBundle[]
  materialTxs         MaterialTransaction[]
  purchaseReceipts    PurchaseReceipt[]
  stockTransfers      StockTransfer[]
  inventoryCounts     InventoryCount[]
  businessAuditLogs   BusinessAuditLog[]
  workerSalaryRules   WorkerMachineSalaryRule[]   @relation("WorkerMachineSalaryRuleWorker")
  createdSalaryRules  WorkerMachineSalaryRule[]   @relation("WorkerMachineSalaryRuleCreator")
  salaryAdjustments   SalaryAdjustment[]          @relation("SalaryAdjustmentCreator")

  @@index([role])
  @@index([workerType])
}

// ============================================================
// 业务主数据编码序列
// ============================================================

model BusinessCodeSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Daily human-readable document numbers. The counter is reserved in a short,
// independent statement so long-running stock transactions do not serialize
// behind a transaction-scoped advisory lock.
model DailyDocumentSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ============================================================
// 客户 / 供应商主数据
// ============================================================

model Party {
  id                   String    @id @default(cuid())
  type                 PartyType
  code                 String    @unique @db.Citext
  name                 String
  shortName            String?
  searchPinyin         String?
  searchPinyinInitials String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  contacts       PartyContact[]
  addresses      PartyAddress[]
  customerOrders Order[]         @relation("OrderCustomerParty")
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderSupplierParty")

  @@index([type])
  @@index([isActive])
  @@index([name])
}

model PartyContact {
  id        String   @id @default(cuid())
  partyId   String
  name      String
  phone     String?
  wechat    String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([phone])
  @@index([isPrimary])
}

model PartyAddress {
  id            String   @id @default(cuid())
  partyId       String
  receiverName  String?
  receiverPhone String?
  province      String?
  city          String?
  district      String?
  detail        String
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([isDefault])
}

// ============================================================
// 工单
// ============================================================

enum OrderStatus {
  DRAFT
  SUBMITTED
  SCHEDULING
  IN_PRODUCTION
  COMPLETED
  SHIPPED
  FINISHED
  CANCELLED
}

model Order {
  id                   String      @id @default(cuid())
  orderNo              String      @unique // GD-YYMMDD-XXX; historical formats remain valid
  submitterId          String
  submitterRole        Role // 冗余：SALES 或 CUSTOMER_SERVICE
  createdById          String // 代下单场景
  customerPartyId      String?
  status               OrderStatus @default(DRAFT)
  requiresOutsource    Boolean     @default(false) // 排产时快照：工单含外协工艺
  isUrgent             Boolean     @default(false)
  customerRef          String? // 客户代号，如"苹果福"
  receiverName         String?
  receiverPhone        String?
  receiverAddress      String?
  expressCode          String? // 快递代码/菜鸟码
  packageRequirement   String?
  remark               String?
  totalAmount          Decimal     @default(0) @db.Decimal(12, 2)
  promisedDate         DateTime? // 承诺交期（对客户）；逾期预警扫描用
  trackingNo           String? // 快递单号
  searchPinyin         String?
  searchPinyinInitials String?
  submittedAt          DateTime?
  scheduledAt          DateTime?
  completedAt          DateTime?
  shippedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  submitter       User             @relation("OrderSubmitter", fields: [submitterId], references: [id])
  createdBy       User             @relation("OrderCreator", fields: [createdById], references: [id])
  customerParty   Party?           @relation("OrderCustomerParty", fields: [customerPartyId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  outsourceOrders OutsourceOrder[]
  logs            OrderLog[]
  billItems       BillItem[]

  @@index([submitterId])
  @@index([customerPartyId])
  @@index([status])
  @@index([createdAt])
  @@index([isUrgent])
  // 交期预警：dashboard 关注列表 + 每日 cron 都按 promisedDate 范围扫
  @@index([promisedDate])
  // Dashboard KPI ranges hit these timestamp columns directly
  // (`getTodayOrderStats` runs 5 range counts per landing-page render).
  // Without these indexes the queries degrade into seq scans on a
  // growing Order table (Codex round 98 P2).
  @@index([submittedAt])
  @@index([completedAt])
  @@index([shippedAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  sequence       Int
  name           String
  productId      String?
  specification  String?
  paperType      String?
  quantity       Int
  crafts         String[] // 工艺ID数组
  foilColor      String?
  isDoubleSided  Boolean  @default(false)
  isDoubleColor  Boolean  @default(false)
  unitPrice      Decimal  @default(0) @db.Decimal(10, 4)
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  suggestedPrice Decimal? @db.Decimal(12, 2)
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?          @relation(fields: [productId], references: [id])
  designs OrderItemDesign[]
  tasks   ProductionTask[]

  @@index([orderId])
}

enum DesignFileType {
  IMAGE
  CDR
}

model OrderItemDesign {
  id           String         @id @default(cuid())
  orderItemId  String
  fileType     DesignFileType
  fileUrl      String // OSS地址
  fileName     String
  fileSize     BigInt
  thumbnailUrl String?
  uploadedBy   String
  uploadedAt   DateTime       @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([fileType])
  @@index([uploadedAt])
}

model OrderLog {
  id            String   @id @default(cuid())
  orderId       String
  operatorId    String
  action        String // CREATE/UPDATE/STATUS_CHANGE/DELETE
  changedFields Json? // { field: { before, after } }
  remark        String?
  createdAt     DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operator User  @relation(fields: [operatorId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

model BusinessAuditLog {
  id               String   @id @default(cuid())
  actorId          String?
  actorRole        Role?
  actorUsername    String?
  actorDisplayName String?
  action           String
  entityType       String
  entityId         String
  before           Json?
  after            Json?
  diff             Json?
  requestMetadata  Json?
  createdAt        DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// 生产任务
// ============================================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionTask {
  id                 String       @id @default(cuid())
  orderItemId        String
  craftId            String
  workerId           String?
  workerType         WorkerType?  // 派工时快照，防止账号后续改岗破坏历史任务
  machineType        MachineType? // 派单时快照
  status             TaskStatus   @default(PENDING)
  plannedQty         Int
  boardCount         Int          @default(0) // 板数（计算值）
  pressCount         Int          @default(0) // 下数（计算值）
  completedQty       Int          @default(0)
  defectQty          Int          @default(0)
  reworkQty          Int          @default(0)
  pieceworkAmount    Decimal      @default(0) @db.Decimal(10, 2)
  salaryRuleSnapshot Json? // 完工时锁定的规则
  startedAt          DateTime?
  completedAt        DateTime?
  remark             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  orderItem       OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  craft           Craft                  @relation(fields: [craftId], references: [id])
  worker          User?                  @relation(fields: [workerId], references: [id])
  dailySalaryItem DailyWorkerSalaryItem?

  @@index([workerId])
  @@index([status])
  @@index([completedAt])
  @@unique([orderItemId, craftId])
}

// ============================================================
// 外协
// ============================================================

enum OutsourceStatus {
  SENT
  IN_PROGRESS
  RECEIVED
  CANCELLED
}

model OutsourceOrder {
  id                 String          @id @default(cuid())
  orderId            String?
  orderItemIds       String[] // 关联款式
  supplierName       String
  supplierContact    String?
  craftDescription   String?
  specialRequirement String? // 特殊要求
  totalQty           Int?
  expectedDate       DateTime?
  actualDate         DateTime?
  amount             Decimal?        @db.Decimal(12, 2)
  status             OutsourceStatus @default(SENT)
  remark             String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  order Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([expectedDate])
}

// ============================================================
// CDR汇总下载
// ============================================================

model DesignBundle {
  id              String             @id @default(cuid())
  createdById     String
  dateRangeFrom   DateTime
  dateRangeTo     DateTime
  orderIds        String[]
  designIds       String[]
  zipFileUrl      String
  downloadUrl     String
  expiresAt       DateTime
  downloadCount   Int                @default(0)
  status          DesignBundleStatus @default(PENDING)
  backgroundJobId String?            @unique
  lastErrorCode   String?
  createdAt       DateTime           @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([status, createdAt])
  @@index([createdAt])
}

// ============================================================
// 字典：工艺
// ============================================================

model Craft {
  id                 String       @id @default(cuid())
  name               String       @unique
  code               String       @unique
  isOutsource        Boolean      @default(false)
  defaultWorkerType  WorkerType?  // 自产工艺的接单岗位；外协工艺为 null
  defaultMachineType MachineType? // 默认机器
  sortOrder          Int          @default(0)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tasks ProductionTask[]

  @@index([isActive])
}

// ============================================================
// 字典：产品与报价（MVP阶段基础版）
// ============================================================

enum ProductCategory {
  BLANK_STOCK
  GENERIC_STOCK
  CUSTOM_FLAT_FOIL
  COLOR_PRINT
  STOCK_FOIL_ADD
  BYO_MATERIAL
}

model Product {
  id                   String          @id @default(cuid())
  code                 String?         @unique @db.Citext
  category             ProductCategory
  categoryNodeId       String
  name                 String
  specification        String?
  paperType            String?
  searchPinyin         String?
  searchPinyinInitials String?
  baseUnitPrice        Decimal?        @db.Decimal(10, 4)
  minOrderQty          Int?
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  categoryNode ProductCategoryNode @relation(fields: [categoryNodeId], references: [id])
  orderItems   OrderItem[]
  priceTiers   PriceTier[]
  boms         BillOfMaterial[]

  @@index([categoryNodeId])
  @@index([category])
  @@index([isActive])
}

model ProductCategoryNode {
  id             String                @id @default(cuid())
  path           String                @unique
  pathLtree      Unsupported("ltree")? @map("pathLtree")
  name           String
  legacyCategory ProductCategory
  sortOrder      Int                   @default(0)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  products Product[]
  boms     BillOfMaterial[]

  @@index([legacyCategory])
  @@index([isActive])
}

model PriceTier {
  id            String    @id @default(cuid())
  productId     String
  minQty        Int
  unitPrice     Decimal   @db.Decimal(10, 4)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum AdjustmentType {
  PER_SHEET
  PER_PIECE
  PER_ORDER
  PER_10K
}

model PriceAdjustment {
  id               String         @id @default(cuid())
  name             String
  adjustmentType   AdjustmentType
  amount           Decimal        @db.Decimal(10, 4)
  triggerCondition Json? // 触发条件
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ============================================================
// BOM / 用料（A19）
// ============================================================

model BillOfMaterial {
  id             String   @id @default(cuid())
  productId      String?
  categoryNodeId String?
  name           String
  version        Int      @default(1)
  baseQuantity   Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product      Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryNode ProductCategoryNode? @relation(fields: [categoryNodeId], references: [id], onDelete: Cascade)
  items        BillOfMaterialItem[]

  @@unique([productId, version])
  @@unique([categoryNodeId, version])
  @@index([productId])
  @@index([categoryNodeId])
  @@index([isActive])
}

model BillOfMaterialItem {
  id         String   @id @default(cuid())
  bomId      String
  materialId String
  quantity   Decimal  @db.Decimal(12, 4)
  sortOrder  Int      @default(10)
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bom      BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id])

  @@unique([bomId, materialId])
  @@index([bomId])
  @@index([materialId])
}

// ============================================================
// 物料（P1阶段）
// ============================================================

enum MaterialCategory {
  PAPER
  FOIL
  BAG
  FINISHED_STOCK
  OTHER
}

model Material {
  id                   String           @id @default(cuid())
  code                 String           @unique @db.Citext
  name                 String
  category             MaterialCategory
  specification        String?
  unit                 String
  searchPinyin         String?
  searchPinyinInitials String?
  currentStock         Decimal          @default(0) @db.Decimal(12, 2)
  safetyStock          Decimal?         @db.Decimal(12, 2)
  averageCost          Decimal?         @db.Decimal(10, 4)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  transactions         MaterialTransaction[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  locationStocks       MaterialLocationStock[]
  bomItems             BillOfMaterialItem[]
  stockTransfers       StockTransfer[]
  inventoryCountItems  InventoryCountItem[]

  @@index([category])
}

enum TxDirection {
  IN
  OUT
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique @db.Citext
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations    WarehouseLocation[]
  stocks       MaterialLocationStock[]
  transactions MaterialTransaction[]

  @@index([isActive])
  @@index([isDefault])
}

model WarehouseLocation {
  id          String   @id @default(cuid())
  warehouseId String
  code        String
  name        String
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse           Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stocks              MaterialLocationStock[]
  transactions        MaterialTransaction[]
  outgoingTransfers   StockTransfer[]         @relation("StockTransferSource")
  incomingTransfers   StockTransfer[]         @relation("StockTransferDestination")
  inventoryCountItems InventoryCountItem[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([isActive])
  @@index([isDefault])
}

model MaterialLocationStock {
  id           String   @id @default(cuid())
  materialId   String
  warehouseId  String
  locationId   String
  currentStock Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material  Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([materialId, locationId])
  @@index([materialId])
  @@index([warehouseId])
  @@index([locationId])
}

model MaterialTransaction {
  id                    String      @id @default(cuid())
  materialId            String
  warehouseId           String?
  locationId            String?
  direction             TxDirection
  quantity              Decimal     @db.Decimal(12, 2)
  reasonType            String // PURCHASE/PRODUCTION_USE/etc
  relatedOrderId        String?
  relatedTaskId         String?
  purchaseReceiptItemId String?
  stockTransferId       String?
  inventoryCountItemId  String?     @unique
  operatorId            String
  unitCost              Decimal?    @db.Decimal(10, 4)
  remark                String?
  occurredAt            DateTime    @default(now())
  createdAt             DateTime    @default(now())

  material            Material             @relation(fields: [materialId], references: [id])
  warehouse           Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location            WarehouseLocation?   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  operator            User                 @relation(fields: [operatorId], references: [id])
  purchaseReceiptItem PurchaseReceiptItem? @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: SetNull)
  stockTransfer       StockTransfer?       @relation(fields: [stockTransferId], references: [id], onDelete: Restrict)
  inventoryCountItem  InventoryCountItem?  @relation(fields: [inventoryCountItemId], references: [id], onDelete: Restrict)

  @@unique([stockTransferId, direction])
  @@index([materialId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([purchaseReceiptItemId])
  @@index([stockTransferId])
  @@index([occurredAt])
}

model StockTransfer {
  id                    String   @id @default(cuid())
  transferNo            String   @unique
  idempotencyKey        String   @unique
  materialId            String
  sourceLocationId      String
  destinationLocationId String
  quantity              Decimal  @db.Decimal(12, 2)
  operatorId            String
  remark                String?
  occurredAt            DateTime @default(now())
  createdAt             DateTime @default(now())

  material             Material              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  sourceLocation       WarehouseLocation     @relation("StockTransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation  WarehouseLocation     @relation("StockTransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  operator             User                  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  materialTransactions MaterialTransaction[]

  @@index([materialId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([occurredAt])
}

model InventoryCount {
  id             String   @id @default(cuid())
  countNo        String   @unique
  idempotencyKey String   @unique
  countedById    String
  countedAt      DateTime @default(now())
  remark         String?
  createdAt      DateTime @default(now())

  countedBy User                 @relation(fields: [countedById], references: [id], onDelete: Restrict)
  items     InventoryCountItem[]

  @@index([countedById])
  @@index([countedAt])
}

model InventoryCountItem {
  id               String   @id @default(cuid())
  inventoryCountId String
  materialId       String
  locationId       String
  bookQuantity     Decimal  @db.Decimal(12, 2)
  countedQuantity  Decimal  @db.Decimal(12, 2)
  difference       Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  inventoryCount      InventoryCount       @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  material            Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  location            WarehouseLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  materialTransaction MaterialTransaction?

  @@unique([inventoryCountId, materialId, locationId])
  @@index([materialId])
  @@index([locationId])
}

// ============================================================
// 采购与入库（A17）
// ============================================================

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseReceiptStatus {
  POSTED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  purchaseNo      String              @unique
  supplierPartyId String?
  supplierCode    String
  supplierName    String
  status          PurchaseOrderStatus @default(ORDERED)
  expectedDate    DateTime?
  remark          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplierParty Party?              @relation("PurchaseOrderSupplierParty", fields: [supplierPartyId], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]
  receipts      PurchaseReceipt[]

  @@index([supplierPartyId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  materialId       String
  quantity         Decimal  @db.Decimal(12, 2)
  receivedQuantity Decimal  @default(0) @db.Decimal(12, 2)
  unitCost         Decimal? @db.Decimal(10, 4)
  remark           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material              @relation(fields: [materialId], references: [id])
  receiptItems  PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([materialId])
}

model PurchaseReceipt {
  id              String                @id @default(cuid())
  receiptNo       String                @unique
  idempotencyKey  String                @unique
  purchaseOrderId String
  receivedById    String
  status          PurchaseReceiptStatus @default(POSTED)
  receivedAt      DateTime              @default(now())
  cancelledAt     DateTime?
  cancelReason    String?
  remark          String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User                  @relation(fields: [receivedById], references: [id])
  items         PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([receivedById])
  @@index([status])
  @@index([receivedAt])
}

model PurchaseReceiptItem {
  id                  String   @id @default(cuid())
  receiptId           String
  purchaseOrderItemId String
  materialId          String
  quantity            Decimal  @db.Decimal(12, 2)
  unitCost            Decimal? @db.Decimal(10, 4)
  createdAt           DateTime @default(now())

  receipt              PurchaseReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem    PurchaseOrderItem     @relation(fields: [purchaseOrderItemId], references: [id])
  material             Material              @relation(fields: [materialId], references: [id])
  materialTransactions MaterialTransaction[]

  @@index([receiptId])
  @@index([purchaseOrderItemId])
  @@index([materialId])
}

// ============================================================
// 薪资体系（核心）
// ============================================================

enum SalaryRuleType {
  CS_COMMISSION
  WORKER_MACHINE
  WORKER_HOURLY
  COOK_SALARY
}

enum SalaryAdjustmentType {
  BONUS
  DEDUCTION
  CORRECTION
}

model SalaryRule {
  id            String         @id @default(cuid())
  ruleType      SalaryRuleType
  ruleKey       String // 具体规则键
  ruleValue     Json // 规则值（结构随ruleType不同）
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  remark        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([ruleType, ruleKey, effectiveFrom])
  @@index([ruleType])
  @@index([effectiveFrom, effectiveTo])
}

// 师傅个人计件规则。完整保存一套规则，命中时优先于机型统一规则；
// 通过 effectiveFrom/effectiveTo 版本化，历史工资不随后台改价漂移。
model WorkerMachineSalaryRule {
  id            String      @id @default(cuid())
  workerId      String
  machineType   MachineType
  ruleValue     Json
  effectiveFrom DateTime
  effectiveTo   DateTime?
  remark        String?
  createdById   String
  createdAt     DateTime    @default(now())

  worker    User @relation("WorkerMachineSalaryRuleWorker", fields: [workerId], references: [id], onDelete: Restrict)
  createdBy User @relation("WorkerMachineSalaryRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workerId, machineType, effectiveFrom])
  @@index([workerId, machineType, effectiveFrom, effectiveTo])
}

// 开机师傅日薪
model DailyWorkerSalary {
  id                   String      @id @default(cuid())
  workerId             String
  date                 DateTime    @db.Date
  machineType          MachineType
  baseSalary           Decimal     @db.Decimal(10, 2)
  totalPieceworkAmount Decimal     @db.Decimal(10, 2)
  adjustmentAmount     Decimal     @default(0) @db.Decimal(10, 2)
  actualSalary         Decimal     @db.Decimal(10, 2) // max(两者)
  taskCount            Int         @default(0)
  orderCount           Int         @default(0)
  calculationDetail    Json? // 每个任务的计件明细
  salaryRuleSnapshot   Json
  isPaid               Boolean     @default(false)
  paidAt               DateTime?
  createdAt            DateTime    @default(now())

  worker      User                    @relation(fields: [workerId], references: [id])
  items       DailyWorkerSalaryItem[]
  adjustments SalaryAdjustment[]

  @@unique([workerId, date])
  @@index([date])
}

// 不可变的计件任务账本。日薪重算时从 ProductionTask 重建；标记发放后
// 日薪被锁定，因此这些快照能稳定支撑后台核查和 Excel 导出。
model DailyWorkerSalaryItem {
  id                 String      @id @default(cuid())
  dailySalaryId      String
  productionTaskId   String      @unique
  orderId            String
  orderNo            String
  orderItemId        String
  orderItemName      String
  craftId            String
  craftName          String
  machineType        MachineType
  completedQty       Int
  defectQty          Int
  reworkQty          Int
  boardCount         Int
  pressCount         Int
  pieceworkAmount    Decimal     @db.Decimal(10, 2)
  salaryRuleSnapshot Json
  completedAt        DateTime
  createdAt          DateTime    @default(now())

  dailySalary    DailyWorkerSalary @relation(fields: [dailySalaryId], references: [id], onDelete: Cascade)
  productionTask ProductionTask    @relation(fields: [productionTaskId], references: [id], onDelete: Restrict)

  @@index([dailySalaryId])
  @@index([orderId])
  @@index([completedAt])
}

// 奖金、扣款和修正采用追加式账目，不覆盖原始任务计件。amount 使用有符号
// 金额：奖金为正、扣款为负、修正可正可负。
model SalaryAdjustment {
  id            String               @id @default(cuid())
  dailySalaryId String
  type          SalaryAdjustmentType
  amount        Decimal              @db.Decimal(10, 2)
  reason        String
  createdById   String
  createdAt     DateTime             @default(now())

  dailySalary DailyWorkerSalary @relation(fields: [dailySalaryId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("SalaryAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([dailySalaryId, createdAt])
  @@index([createdById])
}

// 客服业绩周期
enum SalaryPeriodStatus {
  IN_PROGRESS
  SETTLED
}

model SalaryPeriod {
  id             String             @id @default(cuid())
  csUserId       String
  periodStart    DateTime           @db.Date
  periodEnd      DateTime           @db.Date
  durationMonths Int                @default(4)
  totalSales     Decimal            @default(0) @db.Decimal(12, 2)
  initialSales   Decimal            @default(0) @db.Decimal(12, 2) // 导入的期初业绩
  monthlyBase    Decimal            @db.Decimal(10, 2)
  status         SalaryPeriodStatus @default(IN_PROGRESS)
  settledAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  csUser      User                        @relation(fields: [csUserId], references: [id])
  commissions CustomerServiceCommission[]

  @@index([csUserId])
  @@index([status])
  @@index([periodEnd])
}

// 客服提成记录
model CustomerServiceCommission {
  id                 String    @id @default(cuid())
  csUserId           String
  salaryPeriodId     String    @unique
  totalSales         Decimal   @db.Decimal(12, 2)
  tierRate           Decimal   @db.Decimal(6, 4)
  commissionAmount   Decimal   @db.Decimal(12, 2)
  monthlyBaseTotal   Decimal   @db.Decimal(10, 2)
  totalIncome        Decimal   @db.Decimal(12, 2)
  paidBase           Decimal   @default(0) @db.Decimal(12, 2)
  paidCommission     Decimal   @default(0) @db.Decimal(12, 2)
  isFullyPaid        Boolean   @default(false)
  settledAt          DateTime
  paidAt             DateTime?
  // Full rule snapshot at settlement time: CS_TIERS (including mode),
  // CS_BASE_SALARY, CS_PERIOD_LENGTH. Enough to reproduce WHY this
  // specific tierRate was picked even after the tier table is edited
  // (CLAUDE.md §4.4 rule-snapshot bedrock).
  salaryRuleSnapshot Json?
  createdAt          DateTime  @default(now())

  csUser       User         @relation(fields: [csUserId], references: [id])
  salaryPeriod SalaryPeriod @relation(fields: [salaryPeriodId], references: [id])

  @@index([csUserId])
  @@index([settledAt])
}

// 时薪工月度工资
model HourlyWorkerPayroll {
  id                 String    @id @default(cuid())
  workerId           String
  month              String // YYYY-MM
  totalWorkHours     Decimal   @db.Decimal(6, 2)
  totalOtHours       Decimal   @default(0) @db.Decimal(6, 2)
  totalSpareHours    Decimal   @default(0) @db.Decimal(6, 2) // COOK 专用
  hourlyRate         Decimal   @db.Decimal(6, 2)
  otMultiplier       Decimal   @db.Decimal(4, 2)
  baseSalary         Decimal   @db.Decimal(10, 2) // PACKER/CLEANER=hourlyRate×normal; COOK=monthlyBase
  otSalary           Decimal   @default(0) @db.Decimal(10, 2) // PACKER/CLEANER only
  spareSalary        Decimal   @default(0) @db.Decimal(10, 2) // COOK only
  totalSalary        Decimal   @db.Decimal(10, 2)
  dailyDetail        Json? // 每日工时明细
  // Full rule snapshot at settlement time: hourlyRate / cookMonthly /
  // spareHourlyRate / otMultiplier / workHours config. Enough to
  // reproduce the pay even after the rules table is later edited
  // (CLAUDE.md §4.4 rule-snapshot bedrock, same pattern as CS commission).
  salaryRuleSnapshot Json?
  isPaid             Boolean   @default(false)
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  worker User @relation(fields: [workerId], references: [id])

  @@unique([workerId, month])
  @@index([month])
}

// 时薪工考勤（PACKER / CLEANER / COOK）
// MVP：车间主管每日录入三个数字（normalHours / otHours / spareHours）；
// WORK_HOURS 规则仅用于录入 UI 的"全勤"快速填充 hint，不在后端硬编码。
// 加班边界语义：>= otStart (默认 18:00) 即计入加班（DECISIONS 2026-04-24）。
// 厨师请假：SPEC 未定义；MVP 按"不折扣月薪"处理（DECISIONS 2026-04-24，TODO 需业主确认）。
model Attendance {
  id          String   @id @default(cuid())
  workerId    String
  date        DateTime @db.Date
  normalHours Decimal  @default(0) @db.Decimal(6, 2)
  otHours     Decimal  @default(0) @db.Decimal(6, 2)
  spareHours  Decimal  @default(0) @db.Decimal(6, 2) // COOK 专用
  remark      String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  worker    User @relation("AttendanceWorker", fields: [workerId], references: [id])
  createdBy User @relation("AttendanceCreator", fields: [createdById], references: [id])

  // Idempotent upsert surface: 主管重录同一天要覆盖而非报错
  @@unique([workerId, date])
  @@index([date])
}

// ============================================================
// 销售应收账单
// ============================================================

enum BillStatus {
  DRAFT
  ISSUED
  PARTIAL_PAID
  FULLY_PAID
}

model Bill {
  id          String     @id @default(cuid())
  salesUserId String
  period      String // YYYY-MM
  totalAmount Decimal    @db.Decimal(12, 2)
  paidAmount  Decimal    @default(0) @db.Decimal(12, 2)
  status      BillStatus @default(DRAFT)
  issuedAt    DateTime?
  paidAt      DateTime?
  remark      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  salesUser User       @relation(fields: [salesUserId], references: [id])
  items     BillItem[]

  @@unique([salesUserId, period])
  @@index([status])
  // Dashboard `getMonthlyBillStats` filters by period alone; the
  // composite (salesUserId, period) unique key can't serve a
  // period-only predicate (PG needs leading column). Codex round 98 P2.
  @@index([period])
}

model BillItem {
  id          String   @id @default(cuid())
  billId      String
  orderId     String
  orderAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  bill  Bill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  // Prevent duplicate items for the same (bill, order) under
  // concurrent generateBillsForPeriod runs. The advisory lock in lib
  // closes most of the race, but this is the DB-level last-line guard.
  @@unique([billId, orderId])
  @@index([billId])
}

// ============================================================
// 企业微信推送
// ============================================================

model NotificationChannel {
  id          String   @id @default(cuid())
  channelKey  String   @unique // scheduling_group / owner_group / etc
  channelName String
  webhookUrl  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules NotificationRule[] @relation("ChannelRules")
  logs  NotificationLog[]
}

model NotificationRule {
  id              String   @id @default(cuid())
  eventType       String   @unique // ORDER_SUBMITTED / URGENT_ORDER / etc
  channelIds      String[]
  messageTemplate String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  channels NotificationChannel[] @relation("ChannelRules")
}

enum NotificationStatus {
  SUCCESS
  FAILED
  RETRYING
}

model NotificationLog {
  id             String             @id @default(cuid())
  eventType      String
  channelId      String
  messageContent String
  status         NotificationStatus
  errorMessage   String?
  retryCount     Int                @default(0)
  relatedOrderId String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())

  channel NotificationChannel @relation(fields: [channelId], references: [id])

  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// 持久后台任务（PostgreSQL + Worker）
// ============================================================

enum BackgroundJobQueue {
  LIGHT // 通知、定时扫描、结算等轻任务
  HEAVY // Puppeteer PDF、CDR 压缩等资源密集任务
}

enum BackgroundJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  DEAD
  CANCELLED
}

enum BackgroundJobAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ABANDONED
}

enum DesignBundleStatus {
  PENDING
  READY
  FAILED
}

model BackgroundJob {
  id            String              @id @default(cuid())
  type          String
  queue         BackgroundJobQueue
  dedupeKey     String              @unique
  payload       Json
  result        Json?
  status        BackgroundJobStatus @default(PENDING)
  priority      Int                 @default(100)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(5)
  availableAt   DateTime            @default(now())
  lockedBy      String?
  lockedAt      DateTime?
  heartbeatAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  lastErrorCode String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  attemptLogs BackgroundJobAttempt[]

  @@index([queue, status, priority, availableAt])
  @@index([status, createdAt])
  @@index([lockedAt])
}

model BackgroundJobAttempt {
  id         String                     @id @default(cuid())
  jobId      String
  attempt    Int
  workerId   String
  status     BackgroundJobAttemptStatus @default(RUNNING)
  errorCode  String?
  startedAt  DateTime                   @default(now())
  finishedAt DateTime?
  durationMs Int?

  job BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@index([status, startedAt])
}

model BackgroundWorkerHeartbeat {
  workerId   String             @id
  queue      BackgroundJobQueue
  version    String
  startedAt  DateTime
  lastSeenAt DateTime

  @@index([queue, lastSeenAt])
}

// ============================================================
// 系统配置
// ============================================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  remark    String?
  updatedAt DateTime @updatedAt
}
