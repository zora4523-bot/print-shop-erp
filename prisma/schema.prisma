// Prisma Schema for 红包印刷 ERP
// 版本：对应 SPEC-v1.2 冻结版
// 生成日期：2026-04-22
//
// 技术栈：
//   - Prisma 7（rust-free client，TypeScript 实现）
//   - generator 使用新的 `prisma-client` 而非旧 `prisma-client-js`
//   - 生成产物放在 ./generated/prisma/ 而非 node_modules
//   - 配合 Node.js 24 LTS 使用

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7 不再接受 datasource.url；连接 URL 由 prisma.config.ts 提供给 CLI，
// 运行时 PrismaClient 需显式传入 @prisma/adapter-pg 适配器（见 lib/db.ts、prisma/seed.ts）。
datasource db {
  provider = "postgresql"
}

// ============================================================
// 用户与权限
// ============================================================

enum Role {
  ADMIN
  SALES
  CUSTOMER_SERVICE
  WORKER
}

enum WorkerType {
  MACHINE
  PACKER
  CLEANER
  COOK
}

enum MachineType {
  HAND_PRESS // 开机仔
  WINDMILL // 风车机
  GLUE // 黏封机
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model User {
  id                  String          @id @default(cuid())
  username            String          @unique @db.Citext
  password            String // bcrypt哈希
  role                Role
  workerType          WorkerType? // 仅 role=WORKER 时有值
  machineType         MachineType? // 仅 workerType=MACHINE 时有值；主机型/默认机型
  machineCapabilities MachineType[]   @default([]) // 开机师傅实际可操作的全部机型
  displayName         String
  phone               String?
  avatar              String?
  isActive            Boolean         @default(true)
  employmentType      EmploymentType?
  employmentStartDate DateTime?       @db.Date
  employmentEndDate   DateTime?       @db.Date
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // 关系
  submittedOrders           Order[]                     @relation("OrderSubmitter")
  createdOrders             Order[]                     @relation("OrderCreator")
  assignedTasks             ProductionTask[]
  orderLogs                 OrderLog[]
  salaryPeriods             SalaryPeriod[]
  csCommissions             CustomerServiceCommission[]
  dailyWorkerSalaries       DailyWorkerSalary[]
  hourlyPayrolls            HourlyWorkerPayroll[]
  attendanceRecords         Attendance[]                @relation("AttendanceWorker")
  attendanceCreated         Attendance[]                @relation("AttendanceCreator")
  bills                     Bill[]
  designBundles             DesignBundle[]
  orderExports              OrderExport[]
  materialTxs               MaterialTransaction[]
  purchaseReceipts          PurchaseReceipt[]
  stockTransfers            StockTransfer[]
  inventoryCounts           InventoryCount[]
  businessAuditLogs         BusinessAuditLog[]
  workerSalaryRules         WorkerMachineSalaryRule[]   @relation("WorkerMachineSalaryRuleWorker")
  craftCapabilities         WorkerCraftCapability[]
  createdSalaryRules        WorkerMachineSalaryRule[]   @relation("WorkerMachineSalaryRuleCreator")
  salaryAdjustments         SalaryAdjustment[]          @relation("SalaryAdjustmentCreator")
  requestedOrderChanges     OrderChangeRequest[]        @relation("OrderChangeRequester")
  reviewedOrderChanges      OrderChangeRequest[]        @relation("OrderChangeReviewer")
  recordedBillPayments      BillPayment[]               @relation("BillPaymentRecorder")
  recordedCsPayrollPayments CsPayrollPayment[]          @relation("CsPayrollPaymentRecorder")
  createdOrderCosts         OrderCostEntry[]            @relation("OrderCostCreator")
  createdOutsourceOrders    OutsourceOrder[]            @relation("OutsourceOrderCreator")
  outsourceAmountChanges    OutsourceAmountChange[]     @relation("OutsourceAmountChanger")
  recordedOutsourcePayments OutsourcePayment[]          @relation("OutsourcePaymentRecorder")
  csSalesEntries            CsSalesEntry[]
  createdCustomerCharges    OrderCustomerCharge[]       @relation("OrderCustomerChargeCreator")
  finalizedCustomerCharges  OrderCustomerCharge[]       @relation("OrderCustomerChargeFinalizer")
  createdPlateDetails       OrderItemPlateDetail[]      @relation("OrderItemPlateDetailCreator")
  removedPlateDetails       OrderItemPlateDetail[]      @relation("OrderItemPlateDetailRemover")
  raisedTaskDisputes        ProductionTaskDispute[]     @relation("ProductionTaskDisputeWorker")
  resolvedTaskDisputes      ProductionTaskDispute[]     @relation("ProductionTaskDisputeResolver")
  confirmedOrderPricing     Order[]                     @relation("OrderPricingConfirmer")
  createdPricingRevisions   OrderPricingRevision[]      @relation("OrderPricingRevisionCreator")
  publishedPieceworkBooks   PieceworkPriceBook[]        @relation("PieceworkPriceBookPublisher")
  productionReports         ProductionReport[]          @relation("ProductionReportReporter")
  productionProgressReports ProductionProgressReport[]  @relation("ProductionProgressReportReporter")
  pieceworkSettlements      PieceworkSettlement[]       @relation("PieceworkSettlementReporter")

  @@index([role])
  @@index([workerType])
}

// ============================================================
// 业务主数据编码序列
// ============================================================

model BusinessCodeSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Daily human-readable document numbers. Most callers reserve in a short,
// independent statement; workflows that need atomic idempotent replay may pass
// their owning transaction and reserve only after validation succeeds.
model DailyDocumentSequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Shared credential-attempt GCRA bucket. Keeping this in PostgreSQL makes the
// limit authoritative across PM2 restarts and future multiple web instances.
model LoginRateLimitBucket {
  key                  String   @id
  theoreticalArrivalAt DateTime @db.Timestamptz(3)
  updatedAt            DateTime @db.Timestamptz(3)

  @@index([updatedAt])
}

// ============================================================
// 客户 / 供应商主数据
// ============================================================

model Party {
  id                   String    @id @default(cuid())
  type                 PartyType
  code                 String    @unique @db.Citext
  name                 String
  shortName            String?
  searchPinyin         String?
  searchPinyinInitials String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  contacts       PartyContact[]
  addresses      PartyAddress[]
  customerOrders Order[]         @relation("OrderCustomerParty")
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderSupplierParty")

  @@index([type])
  @@index([isActive])
  @@index([name])
}

model PartyContact {
  id        String   @id @default(cuid())
  partyId   String
  name      String
  phone     String?
  wechat    String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([phone])
  @@index([isPrimary])
}

model PartyAddress {
  id            String   @id @default(cuid())
  partyId       String
  receiverName  String?
  receiverPhone String?
  province      String?
  city          String?
  district      String?
  detail        String
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([isDefault])
}

// ============================================================
// 工单
// ============================================================

enum OrderStatus {
  DRAFT
  PENDING_FACTORY
  SUBMITTED
  SCHEDULING
  IN_PRODUCTION
  COMPLETED
  SHIPPED
  FINISHED
  CANCELLED
}

enum OrderKind {
  NORMAL
  REWORK
}

enum OrderBillingMode {
  CHARGE
  NO_CHARGE
}

// 工单的结算路径在创建时锁定，不随账号后续改岗而改变。
// Role 只负责权限；资金方向由本字段表达。
enum OrderSettlementType {
  EXTERNAL_SALES // 外部销售应付工厂加工费
  INTERNAL_SALES // 工厂内部销售/客服业绩归属
  FACTORY_DIRECT // 管理员代录/工厂直接业务
  NO_CHARGE // 免费重做等不产生应收的工单
}

// 对客价格确认与工单生产状态正交：销售可先提交业务事实，排产前必须
// 形成 AUTO_CONFIRMED / ADMIN_CONFIRMED（历史数据用 LEGACY_CONFIRMED）。
enum OrderPricingStatus {
  LEGACY_CONFIRMED
  AUTO_CONFIRMED
  PENDING_ADMIN_CONFIRMATION
  ADMIN_CONFIRMED
}

// 外部销售建单的业务工艺。该枚举与生产工艺 Craft 主数据分离，
// 也不再把历史计价路由 OrderItemPricingRoute 当作建单事实。
enum OrderCraft {
  PARTIAL
  FULL
  PRINT
}

enum OrderQuotedFeeCompleteness {
  COMPLETE
  EXCLUDES_MANUAL_ITEMS
}

enum OrderItemQuoteDisposition {
  PRICED
  MANUAL_PRICING_REQUIRED
}

// 款式的基础计价路线是互斥的。工艺可以组合，但一个款式不得同时
// 用多套基础价套档；未覆盖的组合必须进入管理员终价。
enum OrderItemPricingRoute {
  STOCK_BLANK
  CUSTOM_SINGLE_FLAT_FOIL
  COLOR_PRINT
  MANUAL_QUOTE
}

enum OrderProductStructure {
  UNSPECIFIED
  STANDARD_ENVELOPE
  WESTERN_ENVELOPE
  TEN_THOUSAND_ENVELOPE
}

enum OrderFoilTechnique {
  UNSPECIFIED
  NONE
  FLAT
  RELIEF
  RAISED
}

enum OrderLamination {
  NONE
  MATTE
  SOFT_TOUCH
  NEW_GLOSS
  LASER
}

enum OrderPackagingMode {
  SINGLE_STYLE
  MIXED_STYLE
}

enum OrderChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  STALE
}

enum ReworkCause {
  QUALITY
  LOGISTICS_DAMAGE
  OTHER
}

model Order {
  id                      String                      @id @default(cuid())
  orderNo                 String                      @unique // GD-YYMMDD-XXX; historical formats remain valid
  submitterId             String
  submitterRole           Role // 创建时身份快照（权限/审计）；不用于推导资金方向
  createdById             String // 代下单场景
  customerPartyId         String?
  status                  OrderStatus                 @default(DRAFT)
  kind                    OrderKind                   @default(NORMAL)
  billingMode             OrderBillingMode            @default(CHARGE)
  settlementType          OrderSettlementType
  sourceOrderId           String?
  reworkCause             ReworkCause?
  reworkReason            String?
  requiresOutsource       Boolean                     @default(false) // 排产时快照：工单含外协工艺
  isUrgent                Boolean                     @default(false)
  customName              String? // 录单人自定义的工单识别名称
  customerRef             String? // 客户名称/简称，如"苹果福"
  receiverName            String?
  receiverPhone           String?
  receiverAddress         String?
  expressCode             String? // 快递代码/菜鸟码
  isSfCollect             Boolean                     @default(false) // 顺丰到付：自行预约，物流费不计入工单金额
  packageRequirement      String?
  remark                  String?
  nextItemFig             Int                         @default(1)
  clientSubmissionId      String?                     @unique
  processingAmount        Decimal                     @default(0) @db.Decimal(12, 2) // 加工费合计 = 各款小计 + 入袋加工费
  packagingAmount         Decimal                     @default(0) @db.Decimal(12, 2) // processingAmount 中的包装组入袋费子集
  totalAmount             Decimal                     @default(0) @db.Decimal(12, 2)
  quotedFee               Decimal?                    @db.Decimal(12, 2)
  confirmedFee            Decimal?                    @db.Decimal(12, 2)
  settledFee              Decimal?                    @db.Decimal(12, 2)
  quotedFeeCompleteness   OrderQuotedFeeCompleteness?
  quotedPricingRevisionId String?
  revision                Int                         @default(1)
  editVersion             Int                         @default(0)
  pricingStatus           OrderPricingStatus          @default(PENDING_ADMIN_CONFIRMATION)
  priceRevision           Int                         @default(1)
  pricingConfirmedAt      DateTime?
  pricingConfirmedById    String?
  promisedDate            DateTime? // 承诺交期（对客户）；逾期预警扫描用
  trackingNo              String? // 快递单号
  searchPinyin            String?
  searchPinyinInitials    String?
  submittedAt             DateTime?
  scheduledAt             DateTime?
  completedAt             DateTime?
  shippedAt               DateTime?
  finishedAt              DateTime?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  submitter               User                     @relation("OrderSubmitter", fields: [submitterId], references: [id])
  createdBy               User                     @relation("OrderCreator", fields: [createdById], references: [id])
  pricingConfirmedBy      User?                    @relation("OrderPricingConfirmer", fields: [pricingConfirmedById], references: [id], onDelete: Restrict)
  customerParty           Party?                   @relation("OrderCustomerParty", fields: [customerPartyId], references: [id], onDelete: SetNull)
  sourceOrder             Order?                   @relation("OrderReworkLineage", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  reworkOrders            Order[]                  @relation("OrderReworkLineage")
  items                   OrderItem[]
  packagingGroups         OrderPackagingGroup[]
  shipments               OrderShipment[]
  outsourceOrders         OutsourceOrder[]
  logs                    OrderLog[]
  billItems               BillItem[]
  changeRequests          OrderChangeRequest[]
  costEntries             OrderCostEntry[]
  customerCharges         OrderCustomerCharge[]
  csSalesEntries          CsSalesEntry[]
  pricingRevisions        OrderPricingRevision[]   @relation("OrderPricingRevisions")
  quotedPricingRevision   OrderPricingRevision?    @relation("OrderQuotedPricingRevision", fields: [quotedPricingRevisionId], references: [id], onDelete: Restrict)
  productionOperations    ProductionOperation[]
  productionProgressSteps ProductionProgressStep[]

  @@index([submitterId])
  @@index([customerPartyId])
  @@index([sourceOrderId])
  @@index([kind])
  @@index([billingMode])
  @@index([settlementType, status, finishedAt])
  @@index([settlementType, pricingStatus, status])
  @@index([pricingConfirmedById])
  @@index([quotedPricingRevisionId])
  @@index([status])
  @@index([createdAt])
  @@index([isUrgent])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([submitterId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  // 交期预警：dashboard 关注列表 + 每日 cron 都按 promisedDate 范围扫
  @@index([promisedDate])
  // Dashboard KPI ranges hit these timestamp columns directly
  // (`getTodayOrderStats` runs 5 range counts per landing-page render).
  // Without these indexes the queries degrade into seq scans on a
  // growing Order table (Codex round 98 P2).
  @@index([submittedAt])
  @@index([completedAt])
  @@index([shippedAt])
}

// 每次形成暂定价、自动确认价或管理员终审价都追加一行。应用层没有更新/
// 删除入口，数据库迁移再用触发器禁止 UPDATE/DELETE，作为不可变财务审计面。
model OrderPricingRevision {
  id          String             @id @default(cuid())
  orderId     String
  revision    Int
  status      OrderPricingStatus
  source      String             @db.VarChar(64)
  snapshot    Json
  createdById String?
  createdAt   DateTime           @default(now())

  order             Order                   @relation("OrderPricingRevisions", fields: [orderId], references: [id], onDelete: Restrict)
  quotedForOrders   Order[]                 @relation("OrderQuotedPricingRevision")
  createdBy         User?                   @relation("OrderPricingRevisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  priceVersionLocks OrderPriceVersionLock[]

  @@unique([orderId, revision])
  @@index([orderId, createdAt(sort: Desc)])
  @@index([createdById])
}

model OrderItem {
  id                  String                     @id @default(cuid())
  orderId             String
  sequence            Int
  fig                 Int?
  name                String
  productId           String?
  pricingRoute        OrderItemPricingRoute
  craft               OrderCraft?
  productStructure    OrderProductStructure
  artworkVersion      String?
  plateGroupId        String?
  pricingGroup        String?
  manualQuoteReason   String?
  specification       String?
  actualWidthMm       Decimal?                   @db.Decimal(8, 2)
  actualHeightMm      Decimal?                   @db.Decimal(8, 2)
  paperType           String?
  paperWeightGsm      Int?
  quantity            Int
  pack                Int?
  crafts              String[] // 工艺ID数组
  // 新报价以正/反面颜色项为唯一过版事实；同一颜色出现在两面仍是两次过版。
  // foilColors / isDoubleSided / isDoubleColor 仅保留给历史读取与旧报表。
  frontFoilColors     String[]                   @default([])
  backFoilColors      String[]                   @default([])
  foilColors          String[]                   @default([])
  foilTechnique       OrderFoilTechnique
  hasLocalFoil        Boolean?
  lamination          OrderLamination            @default(NONE)
  printColors         String[]                   @default([])
  printColorsKnown    Boolean                    @default(false)
  isDoubleSided       Boolean                    @default(false)
  isDoubleColor       Boolean                    @default(false)
  unitPrice           Decimal                    @default(0) @db.Decimal(10, 4)
  fixedFee            Decimal                    @default(0) @db.Decimal(12, 2) // 每款一次性收费/按张折算费用
  subtotal            Decimal                    @default(0) @db.Decimal(12, 2)
  quoteDisposition    OrderItemQuoteDisposition?
  quotedAmount        Decimal?                   @db.Decimal(12, 2)
  suggestedPrice      Decimal?                   @db.Decimal(12, 2) // 历史建议单价（保留原语义，新报价不再写入）
  suggestedSubtotal   Decimal?                   @db.Decimal(12, 2) // 系统建议小计
  pricingSnapshot     Json? // 创建时的规则、分项、数量与结算方向快照
  priceOverrideReason String? // 成交价与建议价不同时的人工说明
  remark              String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  order                   Order                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                 Product?                     @relation(fields: [productId], references: [id])
  designs                 OrderItemDesign[]
  tasks                   ProductionTask[]
  shipmentLines           OrderShipmentLine[]
  packagingGroupLines     OrderPackagingGroupLine[]
  outsourceSnapshots      OutsourceOrderItemSnapshot[]
  plateDetails            OrderItemPlateDetail[]
  operationSources        ProductionOperationSource[]
  productionProgressSteps ProductionProgressStep[]

  @@unique([orderId, sequence])
  @@unique([orderId, fig])
  @@unique([orderId, id])
  @@index([orderId])
  @@index([craft])
  @@index([quoteDisposition])
}

// 每款可有多行制版明细。plateGroupId/specification 是生产与复核事实，
// unitPrice/amount 是对客收费事实；删除采用 isActive 软删除，避免价格历史失真。
model OrderItemPlateDetail {
  id            String    @id @default(cuid())
  orderItemId   String
  sequence      Int
  name          String
  plateGroupId  String?
  specification String?
  quantity      Int
  unitPrice     Decimal   @db.Decimal(12, 2)
  amount        Decimal   @db.Decimal(12, 2)
  remark        String?   @db.Text
  isActive      Boolean   @default(true)
  createdById   String
  removedById   String?
  removedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  createdBy User      @relation("OrderItemPlateDetailCreator", fields: [createdById], references: [id], onDelete: Restrict)
  removedBy User?     @relation("OrderItemPlateDetailRemover", fields: [removedById], references: [id], onDelete: Restrict)

  @@unique([orderItemId, sequence])
  @@index([orderItemId, isActive, sequence])
  @@index([createdById])
  @@index([removedById])
}

// 包装是订单级组合事实，不得塞进单个款式的备注。一个组明确表达
// 单款/混装、实际袋数以及每袋的款式组成，为版本化 0.1/0.2 入袋规则提供证据。
model OrderPackagingGroup {
  id                  String             @id @default(cuid())
  orderId             String
  sequence            Int
  name                String?
  mode                OrderPackagingMode
  actualBagCount      Int
  unitPrice           Decimal            @default(0) @db.Decimal(10, 4)
  subtotal            Decimal            @default(0) @db.Decimal(12, 2)
  suggestedSubtotal   Decimal?           @db.Decimal(12, 2)
  pricingSnapshot     Json?
  priceOverrideReason String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  order            Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines            OrderPackagingGroupLine[]
  operationSources ProductionOperationSource[]

  @@unique([orderId, sequence])
  @@unique([orderId, id])
  @@index([orderId])
}

model OrderPackagingGroupLine {
  id               String @id @default(cuid())
  orderId          String
  packagingGroupId String
  orderItemId      String
  unitsPerBag      Int

  packagingGroup OrderPackagingGroup @relation(fields: [orderId, packagingGroupId], references: [orderId, id], onDelete: Cascade)
  orderItem      OrderItem           @relation(fields: [orderId, orderItemId], references: [orderId, id], onDelete: Cascade)

  @@unique([packagingGroupId, orderItemId])
  @@index([orderItemId])
}

model OrderChangeRequest {
  id              String                   @id @default(cuid())
  orderId         String
  requesterId     String
  baseRevision    Int
  status          OrderChangeRequestStatus @default(PENDING)
  reason          String
  beforeSnapshot  Json
  proposedChanges Json
  reviewedById    String?
  reviewRemark    String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requester  User  @relation("OrderChangeRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("OrderChangeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([orderId, status, createdAt])
  @@index([requesterId, createdAt])
  @@index([status, createdAt])
}

enum ShipmentStatus {
  PLANNED
  SHIPPED
}

model OrderShipment {
  id                  String         @id @default(cuid())
  orderId             String
  sequence            Int
  receiverName        String?
  receiverPhone       String?
  receiverAddress     String?
  expressCode         String?
  carrierCode         String?        @db.VarChar(16) // ZTO / SF / OTHER；不可复用快递代码
  destinationProvince String?        @db.VarChar(32) // 对客物流计费省份，不从自由地址猜测
  quotedWeightKg      Decimal?       @db.Decimal(10, 3) // 创建时承运商计费重量估算
  trackingNo          String?
  weightKg            Decimal?       @db.Decimal(10, 3)
  status              ShipmentStatus @default(PLANNED)
  shippedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines           OrderShipmentLine[]
  customerCharges OrderCustomerCharge[]

  @@unique([orderId, sequence])
  @@index([orderId, status])
}

model OrderShipmentLine {
  id          String @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int

  shipment  OrderShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

enum DesignFileType {
  IMAGE
  CDR
}

model OrderItemDesign {
  id           String         @id @default(cuid())
  orderItemId  String
  fileType     DesignFileType
  fileUrl      String // OSS地址
  fileName     String
  fileSize     BigInt
  thumbnailUrl String?
  uploadedBy   String
  uploadedAt   DateTime       @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([fileType])
  @@index([uploadedAt])
}

model OrderLog {
  id            String   @id @default(cuid())
  orderId       String
  operatorId    String
  action        String // CREATE/UPDATE/STATUS_CHANGE/DELETE
  changedFields Json? // { field: { before, after } }
  remark        String?
  createdAt     DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operator User  @relation(fields: [operatorId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

model BusinessAuditLog {
  id               String   @id @default(cuid())
  actorId          String?
  actorRole        Role?
  actorUsername    String?
  actorDisplayName String?
  action           String
  entityType       String
  entityId         String
  before           Json?
  after            Json?
  diff             Json?
  requestMetadata  Json?
  createdAt        DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// 生产任务
// ============================================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionTaskDisputeStatus {
  PENDING
  RESOLVED
  REJECTED
}

model ProductionTask {
  id                 String        @id @default(cuid())
  orderItemId        String
  craftId            String
  workerId           String?
  workerType         WorkerType? // 派工时快照，防止账号后续改岗破坏历史任务
  machineType        MachineType? // 派单时快照
  status             TaskStatus    @default(PENDING)
  // DB CHECK `ProductionTask_plannedQty_positive_check` 已存在并要求 > 0；
  // Prisma 无 @@check，schema-first 变更禁止覆盖或丢失该约束。
  plannedQty         Int
  boardCount         Int           @default(0) // 板数（计算值）
  pressCount         Int           @default(0) // 下数（计算值）
  completedQty       Int           @default(0)
  defectQty          Int           @default(0)
  reworkQty          Int           @default(0)
  pieceworkAmount    Decimal       @default(0) @db.Decimal(10, 2)
  salaryRuleSnapshot Json? // 完工时锁定的规则
  // 抢单池必须使用显式标记；历史上已有 workerId=NULL 的非抢单任务，
  // 因此不能把“未派师傅”自动解释为“可抢”。
  isSelfClaimable    Boolean       @default(false)
  selfClaimOpenedAt  DateTime?
  selfClaimedAt      DateTime?
  // 释放到抢单池时冻结的可用机型。抢单成功后 machineType 才锁定为
  // 该师傅实际承接的机型，避免工艺字典中途改动破坏在途任务。
  claimMachineTypes  MachineType[] @default([])
  startedAt          DateTime?
  completedAt        DateTime?
  remark             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  orderItem       OrderItem               @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  craft           Craft                   @relation(fields: [craftId], references: [id])
  worker          User?                   @relation(fields: [workerId], references: [id])
  dailySalaryItem DailyWorkerSalaryItem?
  disputes        ProductionTaskDispute[]

  // 同一款式＋同一工艺可按 plannedQty 拆分给多名师傅。
  // 业务层在排产事务内校验各任务数量合计等于款式数量。
  @@index([orderItemId, craftId])
  @@index([workerId])
  @@index([status])
  @@index([completedAt])
  @@index([workerId, status, orderItemId])
  @@index([craftId, status, orderItemId])
}

// 师傅对任务数量、质量或计件金额的异议记录。同一任务可以
// 多次发起，但数据库部分唯一索引保证最多一条 PENDING。记录不提供
// 物理删除路径，migration 触发器作为最后一道审计防线。
model ProductionTaskDispute {
  id               String                      @id @default(cuid())
  productionTaskId String
  workerId         String
  status           ProductionTaskDisputeStatus @default(PENDING)
  reason           String                      @db.Text
  resolution       String?                     @db.Text
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  productionTask ProductionTask @relation(fields: [productionTaskId], references: [id], onDelete: Restrict)
  worker         User           @relation("ProductionTaskDisputeWorker", fields: [workerId], references: [id], onDelete: Restrict)
  resolvedBy     User?          @relation("ProductionTaskDisputeResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([productionTaskId, createdAt(sort: Desc)])
  @@index([workerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([resolvedById])
}

// ============================================================
// 新工序计件域（与旧 ProductionTask / SalaryRule 完全隔离）
// ============================================================

enum PieceworkOperationType {
  PARTIAL
  FULL
  PACKING
}

enum PieceworkRateUnit {
  PER_PASS
  PER_PIECE
  PER_BAG
}

enum PieceworkPriceBookStatus {
  DRAFT
  PUBLISHED
}

enum ProductionOperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionOperationSourceType {
  ORDER_ITEM
  PACKAGING_GROUP
}

enum ProductionReportSource {
  LIVE
  LEGACY_IMPORT
}

enum ProductionReportEntryType {
  REPORT
  REVERSAL
}

enum PieceworkSettlementStatus {
  DRAFT
  LOCKED
  PAID
}

// 对内工价簿独立版本化。DRAFT 可补金额，PUBLISHED 一旦发布后
// 由数据库触发器禁止更改/删除；绝不复用 CustomerPriceBook。
model PieceworkPriceBook {
  id             String                   @id @default(cuid())
  version        Int                      @unique
  status         PieceworkPriceBookStatus @default(DRAFT)
  effectiveFrom  DateTime?                @db.Timestamptz(3)
  effectiveTo    DateTime?                @db.Timestamptz(3)
  sourceName     String?                  @db.Text
  sourceSha256   String?                  @db.VarChar(64)
  manifestSha256 String?                  @db.VarChar(64)
  ruleSetSha256  String?                  @db.VarChar(64)
  publishNote    String?                  @db.Text
  publishedById  String?
  publishedAt    DateTime?                @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)

  publishedBy User?                @relation("PieceworkPriceBookPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  rules       PieceworkPriceRule[]
  reports     ProductionReport[]

  @@index([status, effectiveFrom])
  @@index([publishedById])
  @@index([sourceSha256])
}

model PieceworkPriceRule {
  id            String                 @id @default(cuid())
  priceBookId   String
  operationType PieceworkOperationType
  unit          PieceworkRateUnit
  amount        Decimal?               @db.Decimal(14, 4)
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @db.Timestamptz(3)

  priceBook PieceworkPriceBook @relation(fields: [priceBookId], references: [id], onDelete: Restrict)

  @@unique([priceBookId, operationType])
  @@index([operationType])
}

// 生产工序只记业务类型和计划数，不记工人或机型。来源行只用于
// 追溯数量事实，不参与工价键的选择。
model ProductionOperation {
  id            String                    @id @default(cuid())
  orderId       String
  operationType PieceworkOperationType
  unit          PieceworkRateUnit
  status        ProductionOperationStatus @default(PENDING)
  plannedQty    Decimal                   @db.Decimal(14, 3)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(3)

  order   Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sources ProductionOperationSource[]
  reports ProductionReport[]

  @@index([orderId, status])
  @@index([operationType, status])
}

model ProductionOperationSource {
  id               String                        @id @default(cuid())
  operationId      String
  sourceType       ProductionOperationSourceType
  orderItemId      String?
  packagingGroupId String?
  sourceQty        Decimal                       @db.Decimal(14, 3)
  createdAt        DateTime                      @default(now()) @db.Timestamptz(3)

  operation      ProductionOperation  @relation(fields: [operationId], references: [id], onDelete: Restrict)
  orderItem      OrderItem?           @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  packagingGroup OrderPackagingGroup? @relation(fields: [packagingGroupId], references: [id], onDelete: Restrict)

  @@unique([operationId, orderItemId])
  @@unique([operationId, packagingGroupId])
  @@index([orderItemId])
  @@index([packagingGroupId])
}

// 每次扫码都追加一行。报工人、工价版本和金额快照同行锁定；
// 更正只能追加一条 REVERSAL，数据库触发器禁止 UPDATE / DELETE。
model ProductionReport {
  id                   String                    @id @default(cuid())
  operationId          String
  reporterId           String
  entryType            ProductionReportEntryType @default(REPORT)
  source               ProductionReportSource    @default(LIVE)
  reversalOfId         String?                   @unique
  reportedCompletedQty Decimal                   @db.Decimal(14, 3)
  defectQty            Decimal                   @default(0) @db.Decimal(14, 3)
  reworkQty            Decimal                   @default(0) @db.Decimal(14, 3)
  chargeableQty        Decimal                   @db.Decimal(14, 3)
  unit                 PieceworkRateUnit
  rate                 Decimal                   @db.Decimal(14, 4)
  amount               Decimal                   @db.Decimal(14, 2)
  priceBookId          String
  priceBookVersion     Int
  ruleSetSha256        String                    @db.VarChar(64)
  snapshot             Json
  idempotencyKey       String                    @unique @db.VarChar(128)
  reportedAt           DateTime                  @default(now()) @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)

  operation      ProductionOperation      @relation(fields: [operationId], references: [id], onDelete: Restrict)
  reporter       User                     @relation("ProductionReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  priceBook      PieceworkPriceBook       @relation(fields: [priceBookId], references: [id], onDelete: Restrict)
  reversalOf     ProductionReport?        @relation("ProductionReportReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     ProductionReport?        @relation("ProductionReportReversal")
  settlementItem PieceworkSettlementItem?

  @@index([operationId, reportedAt])
  @@index([reporterId, reportedAt])
  @@index([priceBookId])
}

// 三类计件工序之外的内制工艺只保留生产进度，不存人员/机型/
// 工价。工艺编码和名称在投产时冻结，字典后续改名不改变历史。
model ProductionProgressStep {
  id          String                    @id @default(cuid())
  orderId     String
  orderItemId String
  craftId     String
  craftCode   String                    @db.VarChar(64)
  craftName   String                    @db.VarChar(128)
  status      ProductionOperationStatus @default(PENDING)
  plannedQty  Decimal                   @db.Decimal(14, 3)
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(3)

  order     Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem                  @relation(fields: [orderId, orderItemId], references: [orderId, id], onDelete: Restrict)
  reports   ProductionProgressReport[]

  @@unique([orderItemId, craftId])
  @@index([orderId, status])
  @@index([craftId, status])
}

// 无计件进度的每次扫码也是只追加事实。质量数量只记录，
// 没有 rate / amount / priceBook 字段，因此不可能被计入工资。
model ProductionProgressReport {
  id             String   @id @default(cuid())
  progressStepId String
  reporterId     String
  completedQty   Decimal  @db.Decimal(14, 3)
  defectQty      Decimal  @default(0) @db.Decimal(14, 3)
  reworkQty      Decimal  @default(0) @db.Decimal(14, 3)
  idempotencyKey String   @unique @db.VarChar(128)
  reportedAt     DateTime @default(now()) @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  progressStep ProductionProgressStep @relation(fields: [progressStepId], references: [id], onDelete: Restrict)
  reporter     User                   @relation("ProductionProgressReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([progressStepId, reportedAt])
  @@index([reporterId, reportedAt])
}

// 新 ledger 拥有独立结算边界，不与 DailyWorkerSalaryItem 相加或共用键。
model PieceworkSettlement {
  id               String                    @id @default(cuid())
  reporterId       String
  workDate         DateTime                  @db.Date
  status           PieceworkSettlementStatus @default(DRAFT)
  reportAmount     Decimal                   @db.Decimal(14, 2)
  adjustmentAmount Decimal                   @default(0) @db.Decimal(14, 2)
  payableAmount    Decimal                   @db.Decimal(14, 2)
  snapshot         Json
  lockedAt         DateTime?                 @db.Timestamptz(3)
  paidAt           DateTime?                 @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)

  reporter User                      @relation("PieceworkSettlementReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  items    PieceworkSettlementItem[]

  @@unique([reporterId, workDate])
  @@index([status, workDate])
}

model PieceworkSettlementItem {
  id           String   @id @default(cuid())
  settlementId String
  reportId     String   @unique
  amount       Decimal  @db.Decimal(14, 2)
  snapshot     Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  settlement PieceworkSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  report     ProductionReport    @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([settlementId])
}

// ============================================================
// 外协
// ============================================================

enum OutsourceStatus {
  SENT
  IN_PROGRESS
  RECEIVED
  CANCELLED
}

model OutsourceOrder {
  id                 String          @id @default(cuid())
  idempotencyKey     String          @unique
  orderId            String?
  createdById        String?
  orderItemIds       String[] // 关联款式
  supplierName       String
  supplierContact    String?
  craftDescription   String?
  specialRequirement String? // 特殊要求
  totalQty           Int?
  expectedDate       DateTime?
  actualDate         DateTime?
  amount             Decimal?        @db.Decimal(12, 2)
  status             OutsourceStatus @default(SENT)
  remark             String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  order         Order?                       @relation(fields: [orderId], references: [id])
  createdBy     User?                        @relation("OutsourceOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  amountChanges OutsourceAmountChange[]
  payments      OutsourcePayment[]
  itemSnapshots OutsourceOrderItemSnapshot[]

  @@index([orderId])
  @@index([createdById])
  @@index([status])
  @@index([expectedDate])
}

// 外协单创建时的逐款式数量快照。orderItemIds 继续作为兼容的款式列表，
// 但完工闸口只信任这个不可变账本，避免工单增量被已回货外协单冒领。
model OutsourceOrderItemSnapshot {
  id               String @id @default(cuid())
  outsourceOrderId String
  orderItemId      String
  // DB CHECK `OutsourceOrderItemSnapshot_quantity_positive_check` 已存在并要求 > 0；
  // Prisma 无 @@check，schema-first 变更禁止覆盖或丢失该约束。
  quantity         Int

  outsourceOrder OutsourceOrder @relation(fields: [outsourceOrderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([outsourceOrderId, orderItemId])
  @@index([orderItemId])
}

model OutsourceAmountChange {
  id               String   @id @default(cuid())
  idempotencyKey   String   @unique
  outsourceOrderId String
  previousAmount   Decimal? @db.Decimal(12, 2)
  newAmount        Decimal  @db.Decimal(12, 2)
  reason           String
  changedById      String
  createdAt        DateTime @default(now())

  outsourceOrder OutsourceOrder @relation(fields: [outsourceOrderId], references: [id], onDelete: Restrict)
  changedBy      User           @relation("OutsourceAmountChanger", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([outsourceOrderId, createdAt])
  @@index([changedById, createdAt])
}

// 外协加工应付的追加式付款账本。不与外部销售 Bill 或员工工资混用；
// OutsourceOrder.amount 是确认应付，本表的合计是已付。
model OutsourcePayment {
  id               String   @id @default(cuid())
  idempotencyKey   String   @unique
  outsourceOrderId String
  amount           Decimal  @db.Decimal(12, 2)
  paidAt           DateTime
  method           String?
  reference        String?
  remark           String?
  recordedById     String
  createdAt        DateTime @default(now())

  outsourceOrder OutsourceOrder @relation(fields: [outsourceOrderId], references: [id], onDelete: Restrict)
  recordedBy     User           @relation("OutsourcePaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([outsourceOrderId, paidAt])
  @@index([recordedById, createdAt])
}

// ============================================================
// CDR汇总下载
// ============================================================

model DesignBundle {
  id              String             @id @default(cuid())
  createdById     String
  dateRangeFrom   DateTime
  dateRangeTo     DateTime
  orderIds        String[]
  designIds       String[]
  zipFileUrl      String
  downloadUrl     String
  expiresAt       DateTime
  downloadCount   Int                @default(0)
  status          DesignBundleStatus @default(PENDING)
  backgroundJobId String?            @unique
  lastErrorCode   String?
  createdAt       DateTime           @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([status, createdAt])
  @@index([createdAt])
}

enum OrderExportStatus {
  PENDING
  READY
  FAILED
  EXPIRED
}

// 工单导出是可追溯的重任务：filters + snapshotAt 锁定导出口径，
// schemaVersion 锁定工作簿列定义，避免后续改版时无法解释历史文件。
model OrderExport {
  id                String            @id @default(cuid())
  requestKey        String            @unique
  createdById       String
  filters           Json
  snapshotAt        DateTime
  schemaVersion     Int               @default(1)
  status            OrderExportStatus @default(PENDING)
  backgroundJobId   String?           @unique
  matchedOrderCount Int               @default(0)
  rowCounts         Json?
  artifactName      String?
  fileName          String
  byteSize          BigInt?
  expiresAt         DateTime
  downloadCount     Int               @default(0)
  lastErrorCode     String?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
}

// ============================================================
// 字典：工艺
// ============================================================

model Craft {
  id                  String        @id @default(cuid())
  name                String        @unique
  code                String        @unique
  isOutsource         Boolean       @default(false)
  defaultWorkerType   WorkerType? // 自产工艺的接单岗位；外协工艺为 null
  defaultMachineType  MachineType? // 默认机器
  inHouseMachineTypes MachineType[] @default([]) // 混合工艺回厂生产可选机型
  sortOrder           Int           @default(0)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  tasks          ProductionTask[]
  capableWorkers WorkerCraftCapability[]

  @@index([isActive])
}

// 师傅的工艺熟练项。设备/岗位决定“能不能派”，本表决定“是否推荐”；
// 管理员可越过推荐项派工，但必须留下原因。
model WorkerCraftCapability {
  workerId  String
  craftId   String
  createdAt DateTime @default(now())

  worker User  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  craft  Craft @relation(fields: [craftId], references: [id], onDelete: Cascade)

  @@id([workerId, craftId])
  @@index([craftId])
}

// ============================================================
// 字典：产品与报价（MVP阶段基础版）
// ============================================================

enum ProductCategory {
  BLANK_STOCK
  GENERIC_STOCK
  CUSTOM_FLAT_FOIL
  COLOR_PRINT
  STOCK_FOIL_ADD
  BYO_MATERIAL
}

model Product {
  id                   String          @id @default(cuid())
  code                 String?         @unique @db.Citext
  category             ProductCategory
  categoryNodeId       String
  name                 String
  specification        String?
  paperType            String?
  paperMaterialId      String?
  weight               Int?
  searchPinyin         String?
  searchPinyinInitials String?
  baseUnitPrice        Decimal?        @db.Decimal(10, 4)
  minOrderQty          Int?
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  categoryNode       ProductCategoryNode @relation(fields: [categoryNodeId], references: [id])
  paperMaterial      Material?           @relation("ProductPaperMaterial", fields: [paperMaterialId], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  priceTiers         PriceTier[]
  customerPriceRules CustomerPriceRule[]
  boms               BillOfMaterial[]

  @@index([categoryNodeId])
  @@index([paperMaterialId])
  @@index([category])
  @@index([isActive])
}

model ProductCategoryNode {
  id             String                @id @default(cuid())
  path           String                @unique
  pathLtree      Unsupported("ltree")? @map("pathLtree")
  name           String
  legacyCategory ProductCategory
  sortOrder      Int                   @default(0)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  products Product[]
  boms     BillOfMaterial[]

  @@index([legacyCategory])
  @@index([isActive])
}

model PriceTier {
  id            String    @id @default(cuid())
  productId     String
  minQty        Int
  unitPrice     Decimal   @db.Decimal(10, 4)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum AdjustmentType {
  PER_SHEET
  PER_PIECE
  PER_ORDER
  PER_10K
}

model PriceAdjustment {
  id               String         @id @default(cuid())
  name             String
  adjustmentType   AdjustmentType
  amount           Decimal        @db.Decimal(10, 4)
  triggerCondition Json? // 触发条件
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ============================================================
// 对客价目簿：外部销售与其他结算方向必须显式分簿
// ============================================================

enum CustomerPriceRuleKind {
  BASE
  ADD_ON
  REFERENCE
}

enum CustomerPriceCalculationType {
  PER_PIECE
  FIXED_AMOUNT
  PER_SHEET
  PER_10K
  PER_ITEM
  PER_BAG
}

enum CustomerPriceBookPurpose {
  PROCESSING
  LOGISTICS
}

model CustomerPriceBook {
  id             String                   @id @default(cuid())
  code           String                   @db.Citext
  name           String
  settlementType OrderSettlementType
  purpose        CustomerPriceBookPurpose @default(PROCESSING)
  version        Int
  currency       String                   @default("CNY") @db.VarChar(3)
  sourceName     String
  sourceSha256   String                   @db.VarChar(64)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean                  @default(true)
  notes          Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  rules             CustomerPriceRule[]
  charges           OrderCustomerCharge[]
  priceVersionLocks OrderPriceVersionLock[]

  @@unique([code, version])
  @@index([settlementType, purpose, isActive, effectiveFrom])
  @@index([sourceSha256])
}

// 每次官方报价修订分别锁定加工与物流价目簿。不把两条
// 独立版本流压成一个无法追溯的单值 priceVersion。
model OrderPriceVersionLock {
  id                String                   @id @default(cuid())
  pricingRevisionId String
  purpose           CustomerPriceBookPurpose
  priceBookId       String
  priceBookVersion  Int
  sourceSha256      String                   @db.VarChar(64)
  createdAt         DateTime                 @default(now())

  pricingRevision OrderPricingRevision @relation(fields: [pricingRevisionId], references: [id], onDelete: Restrict)
  priceBook       CustomerPriceBook    @relation(fields: [priceBookId], references: [id], onDelete: Restrict)

  @@unique([pricingRevisionId, purpose])
  @@index([priceBookId])
  @@index([purpose, createdAt])
}

model CustomerChargeCategory {
  id          String   @id @default(cuid())
  code        String   @unique @db.Citext
  name        String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules   CustomerPriceRule[]
  charges OrderCustomerCharge[]

  @@index([isActive, sortOrder])
}

model CustomerPriceRule {
  id                   String                        @id @default(cuid())
  priceBookId          String
  categoryId           String
  productId            String?
  code                 String                        @db.Citext
  name                 String
  kind                 CustomerPriceRuleKind
  calculationType      CustomerPriceCalculationType?
  amount               Decimal?                      @db.Decimal(14, 4)
  includedUnits        Decimal?                      @db.Decimal(10, 3)
  incrementUnits       Decimal?                      @db.Decimal(10, 3)
  incrementAmount      Decimal?                      @db.Decimal(14, 4)
  minQty               Int?
  maxQty               Int?
  triggerCondition     Json?
  exclusiveGroup       String?
  priority             Int                           @default(0)
  sourceSheet          String?
  sourceRange          String?
  sourceName           String?
  sourceSha256         String?                       @db.VarChar(64)
  note                 String?                       @db.Text
  blocksAutomaticQuote Boolean                       @default(false)
  isActive             Boolean                       @default(true)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  priceBook    CustomerPriceBook      @relation(fields: [priceBookId], references: [id], onDelete: Restrict)
  category     CustomerChargeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  product      Product?               @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderCharges OrderCustomerCharge[]

  @@unique([priceBookId, code])
  @@index([priceBookId, kind, isActive, priority])
  @@index([categoryId, isActive])
  @@index([productId, isActive])
  @@index([exclusiveGroup])
}

enum OrderCustomerChargeStatus {
  ESTIMATED
  PENDING_AMOUNT
  FINAL
  WAIVED
}

// 外部销售应付工厂的对客收费。它与 OrderCostEntry（工厂内部成本）
// 是两本独立账，避免物流/耗材应收被错误计入内部成本与毛利。
model OrderCustomerCharge {
  id                String                    @id @default(cuid())
  orderId           String
  shipmentId        String?
  categoryId        String
  priceBookId       String?
  sourceRuleId      String?
  businessKey       String                    @db.Citext
  status            OrderCustomerChargeStatus @default(ESTIMATED)
  description       String
  quantity          Decimal?                  @db.Decimal(12, 3)
  unit              String?
  unitPrice         Decimal?                  @db.Decimal(12, 4)
  suggestedAmount   Decimal?                  @db.Decimal(12, 2)
  amount            Decimal?                  @db.Decimal(12, 2)
  isAdjustment      Boolean                   @default(false)
  pricingSnapshot   Json?
  overrideReason    String?                   @db.Text
  approvalReference String?                   @db.Text
  createdById       String
  finalizedById     String?
  finalizedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment    OrderShipment?         @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  category    CustomerChargeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceBook   CustomerPriceBook?     @relation(fields: [priceBookId], references: [id], onDelete: Restrict)
  sourceRule  CustomerPriceRule?     @relation(fields: [sourceRuleId], references: [id], onDelete: Restrict)
  createdBy   User                   @relation("OrderCustomerChargeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  finalizedBy User?                  @relation("OrderCustomerChargeFinalizer", fields: [finalizedById], references: [id], onDelete: Restrict)

  @@unique([orderId, businessKey])
  @@index([orderId, status, createdAt])
  @@index([shipmentId, categoryId])
  @@index([priceBookId])
  @@index([sourceRuleId])
  @@index([createdById])
  @@index([finalizedById])
}

// ============================================================
// BOM / 用料（A19）
// ============================================================

model BillOfMaterial {
  id             String   @id @default(cuid())
  productId      String?
  categoryNodeId String?
  name           String
  version        Int      @default(1)
  baseQuantity   Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product      Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryNode ProductCategoryNode? @relation(fields: [categoryNodeId], references: [id], onDelete: Cascade)
  items        BillOfMaterialItem[]

  @@unique([productId, version])
  @@unique([categoryNodeId, version])
  @@index([productId])
  @@index([categoryNodeId])
  @@index([isActive])
}

model BillOfMaterialItem {
  id         String   @id @default(cuid())
  bomId      String
  materialId String
  quantity   Decimal  @db.Decimal(12, 4)
  sortOrder  Int      @default(10)
  remark     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bom      BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id])

  @@unique([bomId, materialId])
  @@index([bomId])
  @@index([materialId])
}

// ============================================================
// 物料（P1阶段）
// ============================================================

enum MaterialCategory {
  PAPER
  FOIL
  BAG
  FINISHED_STOCK
  OTHER
}

model Material {
  id                   String           @id @default(cuid())
  code                 String           @unique @db.Citext
  name                 String
  category             MaterialCategory
  specification        String?
  unit                 String
  searchPinyin         String?
  searchPinyinInitials String?
  currentStock         Decimal          @default(0) @db.Decimal(12, 2)
  safetyStock          Decimal?         @db.Decimal(12, 2)
  averageCost          Decimal?         @db.Decimal(10, 4)
  outOfStock           Boolean          @default(false)
  displayColor         String?
  displayImage         String?
  sortOrder            Int              @default(0)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  transactions         MaterialTransaction[]
  purchaseOrderItems   PurchaseOrderItem[]
  purchaseReceiptItems PurchaseReceiptItem[]
  locationStocks       MaterialLocationStock[]
  bomItems             BillOfMaterialItem[]
  paperProducts        Product[]               @relation("ProductPaperMaterial")
  stockTransfers       StockTransfer[]
  inventoryCountItems  InventoryCountItem[]

  @@index([category])
  @@index([category, isActive, sortOrder])
}

enum TxDirection {
  IN
  OUT
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique @db.Citext
  name      String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations    WarehouseLocation[]
  stocks       MaterialLocationStock[]
  transactions MaterialTransaction[]

  @@index([isActive])
  @@index([isDefault])
}

model WarehouseLocation {
  id          String   @id @default(cuid())
  warehouseId String
  code        String
  name        String
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse           Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  stocks              MaterialLocationStock[]
  transactions        MaterialTransaction[]
  outgoingTransfers   StockTransfer[]         @relation("StockTransferSource")
  incomingTransfers   StockTransfer[]         @relation("StockTransferDestination")
  inventoryCountItems InventoryCountItem[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([isActive])
  @@index([isDefault])
}

model MaterialLocationStock {
  id           String   @id @default(cuid())
  materialId   String
  warehouseId  String
  locationId   String
  currentStock Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  material  Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location  WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([materialId, locationId])
  @@index([materialId])
  @@index([warehouseId])
  @@index([locationId])
}

model MaterialTransaction {
  id                    String      @id @default(cuid())
  materialId            String
  warehouseId           String?
  locationId            String?
  direction             TxDirection
  quantity              Decimal     @db.Decimal(12, 2)
  reasonType            String // PURCHASE/PRODUCTION_USE/etc
  relatedOrderId        String?
  relatedTaskId         String?
  purchaseReceiptItemId String?
  stockTransferId       String?
  inventoryCountItemId  String?     @unique
  operatorId            String
  unitCost              Decimal?    @db.Decimal(10, 4)
  remark                String?
  occurredAt            DateTime    @default(now())
  createdAt             DateTime    @default(now())

  material            Material             @relation(fields: [materialId], references: [id])
  warehouse           Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location            WarehouseLocation?   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  operator            User                 @relation(fields: [operatorId], references: [id])
  purchaseReceiptItem PurchaseReceiptItem? @relation(fields: [purchaseReceiptItemId], references: [id], onDelete: SetNull)
  stockTransfer       StockTransfer?       @relation(fields: [stockTransferId], references: [id], onDelete: Restrict)
  inventoryCountItem  InventoryCountItem?  @relation(fields: [inventoryCountItemId], references: [id], onDelete: Restrict)

  @@unique([stockTransferId, direction])
  @@index([materialId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([purchaseReceiptItemId])
  @@index([stockTransferId])
  @@index([occurredAt])
}

model StockTransfer {
  id                    String   @id @default(cuid())
  transferNo            String   @unique
  idempotencyKey        String   @unique
  materialId            String
  sourceLocationId      String
  destinationLocationId String
  quantity              Decimal  @db.Decimal(12, 2)
  operatorId            String
  remark                String?
  occurredAt            DateTime @default(now())
  createdAt             DateTime @default(now())

  material             Material              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  sourceLocation       WarehouseLocation     @relation("StockTransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation  WarehouseLocation     @relation("StockTransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  operator             User                  @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  materialTransactions MaterialTransaction[]

  @@index([materialId])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([occurredAt])
}

model InventoryCount {
  id             String   @id @default(cuid())
  countNo        String   @unique
  idempotencyKey String   @unique
  countedById    String
  countedAt      DateTime @default(now())
  remark         String?
  // 部分过账的冲突结果必须与盘点单同事务落库，同一幂等键重放才能原样回复。
  staleKeys      String[] @default([])
  staleMessage   String?
  createdAt      DateTime @default(now())

  countedBy User                 @relation(fields: [countedById], references: [id], onDelete: Restrict)
  items     InventoryCountItem[]

  @@index([countedById])
  @@index([countedAt])
}

model InventoryCountItem {
  id               String   @id @default(cuid())
  inventoryCountId String
  materialId       String
  locationId       String
  bookQuantity     Decimal  @db.Decimal(12, 2)
  countedQuantity  Decimal  @db.Decimal(12, 2)
  difference       Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  inventoryCount      InventoryCount       @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  material            Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  location            WarehouseLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  materialTransaction MaterialTransaction?

  @@unique([inventoryCountId, materialId, locationId])
  @@index([materialId])
  @@index([locationId])
}

// ============================================================
// 采购与入库（A17）
// ============================================================

enum PurchaseOrderStatus {
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseReceiptStatus {
  POSTED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  purchaseNo      String              @unique
  supplierPartyId String?
  supplierCode    String
  supplierName    String
  status          PurchaseOrderStatus @default(ORDERED)
  expectedDate    DateTime?
  remark          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  supplierParty Party?              @relation("PurchaseOrderSupplierParty", fields: [supplierPartyId], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]
  receipts      PurchaseReceipt[]

  @@index([supplierPartyId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  materialId       String
  quantity         Decimal  @db.Decimal(12, 2)
  receivedQuantity Decimal  @default(0) @db.Decimal(12, 2)
  unitCost         Decimal? @db.Decimal(10, 4)
  remark           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  material      Material              @relation(fields: [materialId], references: [id])
  receiptItems  PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([materialId])
}

model PurchaseReceipt {
  id              String                @id @default(cuid())
  receiptNo       String                @unique
  idempotencyKey  String                @unique
  purchaseOrderId String
  receivedById    String
  status          PurchaseReceiptStatus @default(POSTED)
  receivedAt      DateTime              @default(now())
  cancelledAt     DateTime?
  cancelReason    String?
  remark          String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User                  @relation(fields: [receivedById], references: [id])
  items         PurchaseReceiptItem[]

  @@index([purchaseOrderId])
  @@index([receivedById])
  @@index([status])
  @@index([receivedAt])
}

model PurchaseReceiptItem {
  id                  String   @id @default(cuid())
  receiptId           String
  purchaseOrderItemId String
  materialId          String
  quantity            Decimal  @db.Decimal(12, 2)
  unitCost            Decimal? @db.Decimal(10, 4)
  createdAt           DateTime @default(now())

  receipt              PurchaseReceipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem    PurchaseOrderItem     @relation(fields: [purchaseOrderItemId], references: [id])
  material             Material              @relation(fields: [materialId], references: [id])
  materialTransactions MaterialTransaction[]

  @@index([receiptId])
  @@index([purchaseOrderItemId])
  @@index([materialId])
}

// ============================================================
// 薪资体系（核心）
// ============================================================

enum SalaryRuleType {
  CS_COMMISSION
  WORKER_MACHINE
  WORKER_HOURLY
  COOK_SALARY
}

enum SalaryAdjustmentType {
  BONUS
  DEDUCTION
  CORRECTION
}

model SalaryRule {
  id            String         @id @default(cuid())
  ruleType      SalaryRuleType
  ruleKey       String // 具体规则键
  ruleValue     Json // 规则值（结构随ruleType不同）
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?
  remark        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([ruleType, ruleKey, effectiveFrom])
  @@index([ruleType])
  @@index([effectiveFrom, effectiveTo])
}

// 师傅个人计件规则。完整保存一套规则，命中时优先于机型统一规则；
// 通过 effectiveFrom/effectiveTo 版本化，历史工资不随后台改价漂移。
model WorkerMachineSalaryRule {
  id            String      @id @default(cuid())
  workerId      String
  machineType   MachineType
  ruleValue     Json
  effectiveFrom DateTime
  effectiveTo   DateTime?
  remark        String?
  createdById   String
  createdAt     DateTime    @default(now())

  worker    User @relation("WorkerMachineSalaryRuleWorker", fields: [workerId], references: [id], onDelete: Restrict)
  createdBy User @relation("WorkerMachineSalaryRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workerId, machineType, effectiveFrom])
  @@index([workerId, machineType, effectiveFrom, effectiveTo])
}

// 开机师傅日薪
model DailyWorkerSalary {
  id                   String      @id @default(cuid())
  workerId             String
  date                 DateTime    @db.Date
  machineType          MachineType
  baseSalary           Decimal     @db.Decimal(10, 2)
  totalPieceworkAmount Decimal     @db.Decimal(10, 2)
  adjustmentAmount     Decimal     @default(0) @db.Decimal(10, 2)
  actualSalary         Decimal     @db.Decimal(10, 2) // max(两者)
  taskCount            Int         @default(0)
  orderCount           Int         @default(0)
  calculationDetail    Json? // 每个任务的计件明细
  salaryRuleSnapshot   Json
  isPaid               Boolean     @default(false)
  paidAt               DateTime?
  createdAt            DateTime    @default(now())

  worker      User                    @relation(fields: [workerId], references: [id])
  items       DailyWorkerSalaryItem[]
  adjustments SalaryAdjustment[]

  @@unique([workerId, date])
  @@index([date])
  // 薪资总览的「累计未发」只按 isPaid 过滤，没有日期上界；isPaid 必须打
  // 头才能被用上。date 放第二列：/owner/salary/daily 的未发筛选正好是
  // isPaid=? + date desc，同一棵索引可以顺带服务。
  @@index([isPaid, date])
}

// Durable roster + completion checkpoint for the once-per-date salary cron.
// The JSON roster freezes who was eligible when the first attempt started;
// retries must not silently add/remove workers after account changes.
// DB CHECK `DailySalaryCronRun_roster_array_check`,
// `DailySalaryCronRun_summary_nonnegative_check`,
// `DailySalaryCronRun_total_nonnegative_check`,
// `DailySalaryCronRun_completion_shape_check` 已存在；它们约束 roster 为数组、
// 汇总非负且完成字段成组出现。Prisma 无 @@check，schema-first 变更禁止覆盖或丢失这些约束。
model DailySalaryCronRun {
  date                  DateTime  @id @db.Date
  roster                Json
  completedAt           DateTime?
  summaryWorkerCount    Int?
  summaryTotalAmount    Decimal?  @db.Decimal(14, 2)
  notificationDedupeKey String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
}

// 不可变的计件任务账本。日薪重算时从 ProductionTask 重建；标记发放后
// 日薪被锁定，因此这些快照能稳定支撑后台核查和 Excel 导出。
model DailyWorkerSalaryItem {
  id                 String      @id @default(cuid())
  dailySalaryId      String
  productionTaskId   String      @unique
  orderId            String
  orderNo            String
  orderItemId        String
  orderItemName      String
  craftId            String
  craftName          String
  machineType        MachineType
  completedQty       Int
  defectQty          Int
  reworkQty          Int
  boardCount         Int
  pressCount         Int
  pieceworkAmount    Decimal     @db.Decimal(10, 2)
  salaryRuleSnapshot Json
  completedAt        DateTime
  createdAt          DateTime    @default(now())

  dailySalary    DailyWorkerSalary @relation(fields: [dailySalaryId], references: [id], onDelete: Cascade)
  productionTask ProductionTask    @relation(fields: [productionTaskId], references: [id], onDelete: Restrict)

  @@index([dailySalaryId])
  @@index([orderId])
  @@index([completedAt])
}

// 奖金、扣款和修正采用追加式账目，不覆盖原始任务计件。amount 使用有符号
// 金额：奖金为正、扣款为负、修正可正可负。
model SalaryAdjustment {
  id             String               @id @default(cuid())
  idempotencyKey String               @unique
  dailySalaryId  String
  type           SalaryAdjustmentType
  amount         Decimal              @db.Decimal(10, 2)
  reason         String
  createdById    String
  createdAt      DateTime             @default(now())

  dailySalary DailyWorkerSalary @relation(fields: [dailySalaryId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("SalaryAdjustmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([dailySalaryId, createdAt])
  @@index([createdById])
}

// 客服业绩周期
enum SalaryPeriodStatus {
  IN_PROGRESS
  SETTLED
}

model SalaryPeriod {
  id             String             @id @default(cuid())
  csUserId       String
  periodStart    DateTime           @db.Date
  periodEnd      DateTime           @db.Date
  durationMonths Int                @default(4)
  totalSales     Decimal            @default(0) @db.Decimal(12, 2)
  initialSales   Decimal            @default(0) @db.Decimal(12, 2) // 导入的期初业绩
  monthlyBase    Decimal            @db.Decimal(10, 2)
  status         SalaryPeriodStatus @default(IN_PROGRESS)
  settledAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  csUser          User                        @relation(fields: [csUserId], references: [id])
  commissions     CustomerServiceCommission[]
  salesEntries    CsSalesEntry[]
  payrollPayments CsPayrollPayment[]

  @@index([csUserId])
  @@index([status])
  @@index([periodEnd])
}

enum CsSalesEntryType {
  ORDER_SUBMITTED
  ORDER_CHANGED
  ORDER_CANCELLED
  MANUAL_ADJUSTMENT
}

model CsSalesEntry {
  id             String           @id @default(cuid())
  eventKey       String           @unique
  csUserId       String
  salaryPeriodId String
  orderId        String?
  orderRevision  Int?
  type           CsSalesEntryType
  amount         Decimal          @db.Decimal(12, 2)
  occurredAt     DateTime
  remark         String?
  createdAt      DateTime         @default(now())

  csUser       User         @relation(fields: [csUserId], references: [id], onDelete: Restrict)
  salaryPeriod SalaryPeriod @relation(fields: [salaryPeriodId], references: [id], onDelete: Restrict)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([csUserId, createdAt])
  @@index([salaryPeriodId, createdAt])
  @@index([orderId])
  @@index([occurredAt])
}

// 客服提成记录
model CustomerServiceCommission {
  id                 String    @id @default(cuid())
  csUserId           String
  salaryPeriodId     String    @unique
  totalSales         Decimal   @db.Decimal(12, 2)
  tierRate           Decimal   @db.Decimal(6, 4)
  commissionAmount   Decimal   @db.Decimal(12, 2)
  monthlyBaseTotal   Decimal   @db.Decimal(10, 2)
  totalIncome        Decimal   @db.Decimal(12, 2)
  paidBase           Decimal   @default(0) @db.Decimal(12, 2)
  paidCommission     Decimal   @default(0) @db.Decimal(12, 2)
  isFullyPaid        Boolean   @default(false)
  settledAt          DateTime
  paidAt             DateTime?
  // Full rule snapshot at settlement time: CS_TIERS (including mode),
  // CS_BASE_SALARY, CS_PERIOD_LENGTH. Enough to reproduce WHY this
  // specific tierRate was picked even after the tier table is edited
  // (CLAUDE.md §4.4 rule-snapshot bedrock).
  salaryRuleSnapshot Json?
  createdAt          DateTime  @default(now())

  csUser       User         @relation(fields: [csUserId], references: [id])
  salaryPeriod SalaryPeriod @relation(fields: [salaryPeriodId], references: [id])

  @@index([csUserId])
  @@index([settledAt])
  // 总览的「已结算周期剩余未发」按 isFullyPaid 全表聚合。settledAt 作
  // 第二列，让「未发且最近结算优先」不必再建一棵索引。
  @@index([isFullyPaid, settledAt])
}

// 客服工资发放流水。底薪可在四个月周期进行中按月发放；提成只能在周期
// 结算、金额锁定后发放。CustomerServiceCommission.paidBase / paidCommission
// 是便于查询的累计快照，本表才是不可覆盖的财务事实。
model CsPayrollPayment {
  id               String   @id @default(cuid())
  idempotencyKey   String   @unique
  salaryPeriodId   String
  baseAmount       Decimal  @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal  @default(0) @db.Decimal(12, 2)
  paidAt           DateTime
  paymentMethod    String?
  referenceNo      String?
  remark           String?
  recordedById     String
  createdAt        DateTime @default(now())

  salaryPeriod SalaryPeriod @relation(fields: [salaryPeriodId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation("CsPayrollPaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([salaryPeriodId, paidAt])
  @@index([recordedById, createdAt])
}

// 时薪工月度工资
model HourlyWorkerPayroll {
  id                 String    @id @default(cuid())
  workerId           String
  month              String // YYYY-MM
  totalWorkHours     Decimal   @db.Decimal(6, 2)
  totalOtHours       Decimal   @default(0) @db.Decimal(6, 2)
  totalSpareHours    Decimal   @default(0) @db.Decimal(6, 2) // COOK 专用
  hourlyRate         Decimal   @db.Decimal(6, 2)
  otMultiplier       Decimal   @db.Decimal(4, 2)
  baseSalary         Decimal   @db.Decimal(10, 2) // PACKER/CLEANER=hourlyRate×normal; COOK=monthlyBase
  otSalary           Decimal   @default(0) @db.Decimal(10, 2) // PACKER/CLEANER only
  spareSalary        Decimal   @default(0) @db.Decimal(10, 2) // COOK only
  totalSalary        Decimal   @db.Decimal(10, 2)
  dailyDetail        Json? // 每日工时明细
  // Full rule snapshot at settlement time: hourlyRate / cookMonthly /
  // spareHourlyRate / otMultiplier / workHours config. Enough to
  // reproduce the pay even after the rules table is later edited
  // (CLAUDE.md §4.4 rule-snapshot bedrock, same pattern as CS commission).
  salaryRuleSnapshot Json?
  isPaid             Boolean   @default(false)
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  worker User @relation(fields: [workerId], references: [id])

  @@unique([workerId, month])
  @@index([month])
  // 同 DailyWorkerSalary：总览的「累计未发」按 isPaid 全表过滤，
  // listHourlyPayrolls 的未发筛选是 isPaid=? + month desc。
  @@index([isPaid, month])
}

// 时薪工考勤（PACKER / CLEANER / COOK）
// MVP：车间主管每日录入三个数字（normalHours / otHours / spareHours）；
// WORK_HOURS 规则仅用于录入 UI 的"全勤"快速填充 hint，不在后端硬编码。
// 加班边界语义：>= otStart (默认 18:00) 即计入加班（DECISIONS 2026-04-24）。
// 厨师请假：SPEC 未定义；MVP 按"不折扣月薪"处理（DECISIONS 2026-04-24，TODO 需业主确认）。
model Attendance {
  id                       String      @id @default(cuid())
  workerId                 String
  date                     DateTime    @db.Date
  normalHours              Decimal     @default(0) @db.Decimal(6, 2)
  otHours                  Decimal     @default(0) @db.Decimal(6, 2)
  spareHours               Decimal     @default(0) @db.Decimal(6, 2) // COOK 专用
  workUnits                Decimal     @default(1) @db.Decimal(2, 1)
  leaveUnits               Decimal     @default(0) @db.Decimal(2, 1)
  leaveType                String?
  remark                   String?
  roleSnapshot             Role // 录入时身份；后续改岗不能改变历史工资归属
  workerTypeSnapshot       WorkerType? // 录入时工种；非 WORKER 为 null
  identitySnapshotVerified Boolean     @default(true) // 兼容审计已验证；新记录在写入时即有原始身份
  createdById              String
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  worker    User @relation("AttendanceWorker", fields: [workerId], references: [id])
  createdBy User @relation("AttendanceCreator", fields: [createdById], references: [id])

  // Idempotent upsert surface: 主管重录同一天要覆盖而非报错
  @@unique([workerId, date])
  @@index([date])
}

// ============================================================
// 销售应收账单
// ============================================================

enum BillStatus {
  DRAFT
  ISSUED
  PARTIAL_PAID
  FULLY_PAID
}

enum OrderCostCategory {
  MATERIAL
  PIECEWORK
  SETUP
  OUTSOURCE
  SHIPPING
  MEAL
  ELECTRICITY
  CUSTOM
  ADJUSTMENT
}

model Bill {
  id            String     @id @default(cuid())
  salesUserId   String
  period        String // YYYY-MM
  openingAmount Decimal    @default(0) @db.Decimal(12, 2) // 流水启用前的期初/历史账面差额
  totalAmount   Decimal    @db.Decimal(12, 2)
  paidAmount    Decimal    @default(0) @db.Decimal(12, 2)
  status        BillStatus @default(DRAFT)
  issuedAt      DateTime?
  paidAt        DateTime?
  remark        String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  salesUser User          @relation(fields: [salesUserId], references: [id])
  items     BillItem[]
  payments  BillPayment[]

  @@unique([salesUserId, period])
  @@index([status])
  // Dashboard `getMonthlyBillStats` filters by period alone; the
  // composite (salesUserId, period) unique key can't serve a
  // period-only predicate (PG needs leading column). Codex round 98 P2.
  @@index([period])
}

model BillPayment {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  billId         String
  amount         Decimal  @db.Decimal(12, 2)
  paidAt         DateTime
  paymentMethod  String?
  referenceNo    String?
  remark         String?
  recordedById   String
  createdAt      DateTime @default(now())

  bill       Bill @relation(fields: [billId], references: [id], onDelete: Restrict)
  recordedBy User @relation("BillPaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([billId, paidAt])
  @@index([recordedById, createdAt])
}

model BillItem {
  id          String   @id @default(cuid())
  billId      String
  orderId     String
  orderAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  bill  Bill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  // Prevent duplicate items for the same (bill, order) under
  // concurrent generateBillsForPeriod runs. The advisory lock in lib
  // closes most of the race, but this is the DB-level last-line guard.
  @@unique([billId, orderId])
  @@index([billId])
}

model OrderCostEntry {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique
  orderId        String
  category       OrderCostCategory
  description    String
  quantity       Decimal?          @db.Decimal(12, 3)
  unit           String?
  unitPrice      Decimal?          @db.Decimal(12, 4)
  amount         Decimal           @db.Decimal(12, 2)
  sourceType     String?
  sourceId       String?
  remark         String?
  createdById    String
  createdAt      DateTime          @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy User  @relation("OrderCostCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([orderId, category, createdAt])
  @@index([sourceType, sourceId])
  @@index([createdById, createdAt])
}

// ============================================================
// 企业微信推送
// ============================================================

model NotificationChannel {
  id          String   @id @default(cuid())
  channelKey  String   @unique // scheduling_group / owner_group / etc
  channelName String
  webhookUrl  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules NotificationRule[] @relation("ChannelRules")
  logs  NotificationLog[]
}

model NotificationRule {
  id              String   @id @default(cuid())
  eventType       String   @unique // ORDER_SUBMITTED / URGENT_ORDER / etc
  channelIds      String[]
  messageTemplate String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  channels NotificationChannel[] @relation("ChannelRules")
}

enum NotificationStatus {
  SENDING
  SUCCESS
  FAILED
  RETRYING
  UNKNOWN
}

model NotificationLog {
  id                   String             @id @default(cuid())
  eventType            String
  channelId            String
  // 一次「逻辑投递」的稳定标识 = BackgroundJob.dedupeKey，跨 job attempt 不变。
  // durable worker 在 HTTP 前先原子预留 (deliveryKey, channelId) 并写
  // SENDING + deliveryAttemptId。只有持有 fencing token 的 worker 能落终态；
  // SUCCESS/FAILED/UNKNOWN/SENDING 都不再自动重发，只有明确未送达的
  // RETRYING 可以被下一 attempt 重领。
  //
  // 可空：inline/dev 路径与 owner 的「测试发送」不带 key。PG 唯一索引默认
  // NULLS DISTINCT，任意多条 NULL 行互不冲突，所以存量数据与老路径零影响。
  deliveryKey          String?
  messageContent       String
  status               NotificationStatus
  errorMessage         String?
  retryCount           Int                @default(0)
  relatedOrderId       String?
  sentAt               DateTime?
  // Unique fencing token for the process that atomically claimed this
  // channel delivery. A stale worker cannot overwrite a later terminal state.
  deliveryAttemptId    String?
  // BackgroundJob.attempts generation that owns SENDING. A later generation
  // may fence an abandoned reservation to UNKNOWN; the same generation may
  // only observe it and must never steal it.
  deliveryJobAttempt   Int?
  // Monotonic CAS generation for owner resolution. Status alone cannot prevent
  // UNKNOWN -> RETRYING -> SENDING -> UNKNOWN ABA from accepting a stale form.
  deliveryStateVersion Int                @default(0)
  lastAttemptAt        DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt

  channel NotificationChannel @relation(fields: [channelId], references: [id])

  @@unique([deliveryKey, channelId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@index([status, lastAttemptAt])
  @@index([lastAttemptAt(sort: Desc), id(sort: Desc)])
}

// ============================================================
// 持久后台任务（PostgreSQL + Worker）
// ============================================================

enum BackgroundJobQueue {
  LIGHT // 通知、定时扫描、结算等轻任务
  HEAVY // Puppeteer PDF、CDR 压缩等资源密集任务
}

enum BackgroundJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  DEAD
  CANCELLED
}

enum BackgroundJobAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  ABANDONED
}

enum DesignBundleStatus {
  PENDING
  READY
  FAILED
}

model BackgroundJob {
  id            String              @id @default(cuid())
  type          String
  queue         BackgroundJobQueue
  dedupeKey     String              @unique
  payload       Json
  result        Json?
  status        BackgroundJobStatus @default(PENDING)
  priority      Int                 @default(100)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(5)
  availableAt   DateTime            @default(now())
  lockedBy      String?
  lockedAt      DateTime?
  heartbeatAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  lastErrorCode String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  attemptLogs BackgroundJobAttempt[]

  @@index([queue, status, priority, availableAt])
  @@index([status, createdAt])
  @@index([lockedAt])
}

model BackgroundJobAttempt {
  id         String                     @id @default(cuid())
  jobId      String
  attempt    Int
  workerId   String
  status     BackgroundJobAttemptStatus @default(RUNNING)
  errorCode  String?
  startedAt  DateTime                   @default(now())
  finishedAt DateTime?
  durationMs Int?

  job BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@index([status, startedAt])
}

model BackgroundWorkerHeartbeat {
  workerId   String             @id
  queue      BackgroundJobQueue
  version    String
  startedAt  DateTime
  lastSeenAt DateTime

  @@index([queue, lastSeenAt])
}

// ============================================================
// 系统配置
// ============================================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  remark    String?
  updatedAt DateTime @updatedAt
}
