// Prisma Schema for 红包印刷 ERP
// 版本：对应 SPEC-v1.2 冻结版
// 生成日期：2026-04-22
//
// 技术栈：
//   - Prisma 7（rust-free client，TypeScript 实现）
//   - generator 使用新的 `prisma-client` 而非旧 `prisma-client-js`
//   - 生成产物放在 ./generated/prisma/ 而非 node_modules
//   - 配合 Node.js 24 LTS 使用

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户与权限
// ============================================================

enum Role {
  OWNER
  FOREMAN
  SALES
  CUSTOMER_SERVICE
  WORKER
}

enum WorkerType {
  MACHINE
  PACKER
  CLEANER
  COOK
}

enum MachineType {
  HAND_PRESS  // 开机仔
  WINDMILL    // 风车机
  GLUE        // 黏封机
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  password     String       // bcrypt哈希
  role         Role
  workerType   WorkerType?  // 仅 role=WORKER 时有值
  machineType  MachineType? // 仅 workerType=MACHINE 时有值
  displayName  String
  phone        String?
  avatar       String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // 关系
  submittedOrders     Order[]                     @relation("OrderSubmitter")
  createdOrders       Order[]                     @relation("OrderCreator")
  assignedTasks       ProductionTask[]
  orderLogs           OrderLog[]
  salaryPeriods       SalaryPeriod[]
  csCommissions       CustomerServiceCommission[]
  dailyWorkerSalaries DailyWorkerSalary[]
  hourlyPayrolls      HourlyWorkerPayroll[]
  bills               Bill[]
  designBundles       DesignBundle[]
  materialTxs         MaterialTransaction[]

  @@index([role])
  @@index([workerType])
}

// ============================================================
// 工单
// ============================================================

enum OrderStatus {
  DRAFT
  SUBMITTED
  SCHEDULING
  IN_PRODUCTION
  COMPLETED
  SHIPPED
  FINISHED
  CANCELLED
}

model Order {
  id                 String      @id @default(cuid())
  orderNo            String      @unique // YYYYMMDD-XXXX
  submitterId        String
  submitterRole      Role // 冗余：SALES 或 CUSTOMER_SERVICE
  createdById        String // 代下单场景
  status             OrderStatus @default(DRAFT)
  isUrgent           Boolean     @default(false)
  customerRef        String? // 客户代号，如"苹果福"
  receiverName       String?
  receiverPhone      String?
  receiverAddress    String?
  expressCode        String? // 快递代码/菜鸟码
  packageRequirement String?
  remark             String?
  totalAmount        Decimal     @default(0) @db.Decimal(12, 2)
  trackingNo         String? // 快递单号
  submittedAt        DateTime?
  scheduledAt        DateTime?
  completedAt        DateTime?
  shippedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  submitter       User             @relation("OrderSubmitter", fields: [submitterId], references: [id])
  createdBy       User             @relation("OrderCreator", fields: [createdById], references: [id])
  items           OrderItem[]
  outsourceOrders OutsourceOrder[]
  logs            OrderLog[]
  billItems       BillItem[]

  @@index([submitterId])
  @@index([status])
  @@index([createdAt])
  @@index([isUrgent])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  sequence        Int
  name            String
  productId       String?
  specification   String?
  paperType       String?
  quantity        Int
  crafts          String[] // 工艺ID数组
  foilColor       String?
  isDoubleSided   Boolean  @default(false)
  isDoubleColor   Boolean  @default(false)
  unitPrice       Decimal  @default(0) @db.Decimal(10, 4)
  subtotal        Decimal  @default(0) @db.Decimal(12, 2)
  suggestedPrice  Decimal? @db.Decimal(12, 2)
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product?            @relation(fields: [productId], references: [id])
  designs  OrderItemDesign[]
  tasks    ProductionTask[]

  @@index([orderId])
}

enum DesignFileType {
  IMAGE
  CDR
}

model OrderItemDesign {
  id            String         @id @default(cuid())
  orderItemId   String
  fileType      DesignFileType
  fileUrl       String // OSS地址
  fileName      String
  fileSize      BigInt
  thumbnailUrl  String?
  uploadedBy    String
  uploadedAt    DateTime       @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([fileType])
  @@index([uploadedAt])
}

model OrderLog {
  id             String   @id @default(cuid())
  orderId        String
  operatorId     String
  action         String // CREATE/UPDATE/STATUS_CHANGE/DELETE
  changedFields  Json? // { field: { before, after } }
  remark         String?
  createdAt      DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operator User  @relation(fields: [operatorId], references: [id])

  @@index([orderId])
  @@index([createdAt])
}

// ============================================================
// 生产任务
// ============================================================

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionTask {
  id                   String       @id @default(cuid())
  orderItemId          String
  craftId              String
  workerId             String?
  machineType          MachineType? // 派单时快照
  status               TaskStatus   @default(PENDING)
  plannedQty           Int
  boardCount           Int          @default(0) // 板数（计算值）
  pressCount           Int          @default(0) // 下数（计算值）
  completedQty         Int          @default(0)
  defectQty            Int          @default(0)
  reworkQty            Int          @default(0)
  pieceworkAmount      Decimal      @default(0) @db.Decimal(10, 2)
  salaryRuleSnapshot   Json? // 完工时锁定的规则
  startedAt            DateTime?
  completedAt          DateTime?
  remark               String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  craft     Craft     @relation(fields: [craftId], references: [id])
  worker    User?     @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([status])
  @@index([completedAt])
}

// ============================================================
// 外协
// ============================================================

enum OutsourceStatus {
  SENT
  IN_PROGRESS
  RECEIVED
  CANCELLED
}

model OutsourceOrder {
  id                  String          @id @default(cuid())
  orderId             String?
  orderItemIds        String[] // 关联款式
  supplierName        String
  supplierContact     String?
  craftDescription    String?
  specialRequirement  String? // 特殊要求
  totalQty            Int?
  expectedDate        DateTime?
  actualDate          DateTime?
  amount              Decimal?        @db.Decimal(12, 2)
  status              OutsourceStatus @default(SENT)
  remark              String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  order Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([expectedDate])
}

// ============================================================
// CDR汇总下载
// ============================================================

model DesignBundle {
  id             String   @id @default(cuid())
  createdById    String
  dateRangeFrom  DateTime
  dateRangeTo    DateTime
  orderIds       String[]
  designIds      String[]
  zipFileUrl     String
  downloadUrl    String
  expiresAt      DateTime
  downloadCount  Int      @default(0)
  createdAt      DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([createdAt])
}

// ============================================================
// 字典：工艺
// ============================================================

model Craft {
  id                  String       @id @default(cuid())
  name                String       @unique
  code                String       @unique
  isOutsource         Boolean      @default(false)
  defaultMachineType  MachineType? // 默认机器
  sortOrder           Int          @default(0)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tasks ProductionTask[]

  @@index([isActive])
}

// ============================================================
// 字典：产品与报价（MVP阶段基础版）
// ============================================================

enum ProductCategory {
  BLANK_STOCK
  GENERIC_STOCK
  CUSTOM_FLAT_FOIL
  COLOR_PRINT
  STOCK_FOIL_ADD
  BYO_MATERIAL
}

model Product {
  id             String           @id @default(cuid())
  category       ProductCategory
  name           String
  specification  String?
  paperType      String?
  baseUnitPrice  Decimal?         @db.Decimal(10, 4)
  minOrderQty    Int?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  orderItems OrderItem[]
  priceTiers PriceTier[]

  @@index([category])
  @@index([isActive])
}

model PriceTier {
  id             String    @id @default(cuid())
  productId      String
  minQty         Int
  unitPrice      Decimal   @db.Decimal(10, 4)
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum AdjustmentType {
  PER_SHEET
  PER_PIECE
  PER_ORDER
  PER_10K
}

model PriceAdjustment {
  id               String         @id @default(cuid())
  name             String
  adjustmentType   AdjustmentType
  amount           Decimal        @db.Decimal(10, 4)
  triggerCondition Json? // 触发条件
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ============================================================
// 物料（P1阶段）
// ============================================================

enum MaterialCategory {
  PAPER
  FOIL
  BAG
  FINISHED_STOCK
  OTHER
}

model Material {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  category       MaterialCategory
  specification  String?
  unit           String
  currentStock   Decimal          @default(0) @db.Decimal(12, 2)
  safetyStock    Decimal?         @db.Decimal(12, 2)
  averageCost    Decimal?         @db.Decimal(10, 4)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  transactions MaterialTransaction[]

  @@index([category])
}

enum TxDirection {
  IN
  OUT
}

model MaterialTransaction {
  id               String      @id @default(cuid())
  materialId       String
  direction        TxDirection
  quantity         Decimal     @db.Decimal(12, 2)
  reasonType       String // PURCHASE/PRODUCTION_USE/etc
  relatedOrderId   String?
  relatedTaskId    String?
  operatorId       String
  unitCost         Decimal?    @db.Decimal(10, 4)
  remark           String?
  occurredAt       DateTime    @default(now())
  createdAt        DateTime    @default(now())

  material Material @relation(fields: [materialId], references: [id])
  operator User     @relation(fields: [operatorId], references: [id])

  @@index([materialId])
  @@index([occurredAt])
}

// ============================================================
// 薪资体系（核心）
// ============================================================

enum SalaryRuleType {
  CS_COMMISSION
  WORKER_MACHINE
  WORKER_HOURLY
  COOK_SALARY
}

model SalaryRule {
  id             String         @id @default(cuid())
  ruleType       SalaryRuleType
  ruleKey        String // 具体规则键
  ruleValue      Json // 规则值（结构随ruleType不同）
  effectiveFrom  DateTime       @default(now())
  effectiveTo    DateTime?
  remark         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([ruleType, ruleKey, effectiveFrom])
  @@index([ruleType])
  @@index([effectiveFrom, effectiveTo])
}

// 开机师傅日薪
model DailyWorkerSalary {
  id                   String      @id @default(cuid())
  workerId             String
  date                 DateTime    @db.Date
  machineType          MachineType
  baseSalary           Decimal     @db.Decimal(10, 2)
  totalPieceworkAmount Decimal     @db.Decimal(10, 2)
  actualSalary         Decimal     @db.Decimal(10, 2) // max(两者)
  taskCount            Int         @default(0)
  orderCount           Int         @default(0)
  calculationDetail    Json? // 每个任务的计件明细
  salaryRuleSnapshot   Json
  isPaid               Boolean     @default(false)
  paidAt               DateTime?
  createdAt            DateTime    @default(now())

  worker User @relation(fields: [workerId], references: [id])

  @@unique([workerId, date])
  @@index([date])
}

// 客服业绩周期
enum SalaryPeriodStatus {
  IN_PROGRESS
  SETTLED
}

model SalaryPeriod {
  id             String              @id @default(cuid())
  csUserId       String
  periodStart    DateTime            @db.Date
  periodEnd      DateTime            @db.Date
  durationMonths Int                 @default(4)
  totalSales     Decimal             @default(0) @db.Decimal(12, 2)
  initialSales   Decimal             @default(0) @db.Decimal(12, 2) // 导入的期初业绩
  monthlyBase    Decimal             @db.Decimal(10, 2)
  status         SalaryPeriodStatus  @default(IN_PROGRESS)
  settledAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  csUser      User                         @relation(fields: [csUserId], references: [id])
  commissions CustomerServiceCommission[]

  @@index([csUserId])
  @@index([status])
  @@index([periodEnd])
}

// 客服提成记录
model CustomerServiceCommission {
  id                String    @id @default(cuid())
  csUserId          String
  salaryPeriodId    String    @unique
  totalSales        Decimal   @db.Decimal(12, 2)
  tierRate          Decimal   @db.Decimal(6, 4)
  commissionAmount  Decimal   @db.Decimal(12, 2)
  monthlyBaseTotal  Decimal   @db.Decimal(10, 2)
  totalIncome       Decimal   @db.Decimal(12, 2)
  paidBase          Decimal   @default(0) @db.Decimal(12, 2)
  paidCommission    Decimal   @default(0) @db.Decimal(12, 2)
  isFullyPaid       Boolean   @default(false)
  settledAt         DateTime
  paidAt            DateTime?
  createdAt         DateTime  @default(now())

  csUser       User         @relation(fields: [csUserId], references: [id])
  salaryPeriod SalaryPeriod @relation(fields: [salaryPeriodId], references: [id])

  @@index([csUserId])
  @@index([settledAt])
}

// 时薪工月度工资
model HourlyWorkerPayroll {
  id              String   @id @default(cuid())
  workerId        String
  month           String // YYYY-MM
  totalWorkHours  Decimal  @db.Decimal(6, 2)
  totalOtHours    Decimal  @default(0) @db.Decimal(6, 2)
  hourlyRate      Decimal  @db.Decimal(6, 2)
  otMultiplier    Decimal  @db.Decimal(4, 2)
  baseSalary      Decimal  @db.Decimal(10, 2)
  otSalary        Decimal  @default(0) @db.Decimal(10, 2)
  totalSalary     Decimal  @db.Decimal(10, 2)
  dailyDetail     Json? // 每日工时明细
  isPaid          Boolean  @default(false)
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  worker User @relation(fields: [workerId], references: [id])

  @@unique([workerId, month])
  @@index([month])
}

// ============================================================
// 销售应收账单
// ============================================================

enum BillStatus {
  DRAFT
  ISSUED
  PARTIAL_PAID
  FULLY_PAID
}

model Bill {
  id           String     @id @default(cuid())
  salesUserId  String
  period       String // YYYY-MM
  totalAmount  Decimal    @db.Decimal(12, 2)
  paidAmount   Decimal    @default(0) @db.Decimal(12, 2)
  status       BillStatus @default(DRAFT)
  issuedAt     DateTime?
  paidAt       DateTime?
  remark       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  salesUser User       @relation(fields: [salesUserId], references: [id])
  items     BillItem[]

  @@unique([salesUserId, period])
  @@index([status])
}

model BillItem {
  id            String   @id @default(cuid())
  billId        String
  orderId       String
  orderAmount   Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  bill  Bill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id])

  @@index([billId])
}

// ============================================================
// 企业微信推送
// ============================================================

model NotificationChannel {
  id          String   @id @default(cuid())
  channelKey  String   @unique // scheduling_group / owner_group / etc
  channelName String
  webhookUrl  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules NotificationRule[] @relation("ChannelRules")
  logs  NotificationLog[]
}

model NotificationRule {
  id              String   @id @default(cuid())
  eventType       String   @unique // ORDER_SUBMITTED / URGENT_ORDER / etc
  channelIds      String[]
  messageTemplate String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  channels NotificationChannel[] @relation("ChannelRules")
}

enum NotificationStatus {
  SUCCESS
  FAILED
  RETRYING
}

model NotificationLog {
  id               String             @id @default(cuid())
  eventType        String
  channelId        String
  messageContent   String
  status           NotificationStatus
  errorMessage     String?
  retryCount       Int                @default(0)
  relatedOrderId   String?
  sentAt           DateTime?
  createdAt        DateTime           @default(now())

  channel NotificationChannel @relation(fields: [channelId], references: [id])

  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// 系统配置
// ============================================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  remark    String?
  updatedAt DateTime @updatedAt
}
