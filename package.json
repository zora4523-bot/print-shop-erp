{
  "name": "print-shop-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:light": "node --conditions=react-server --import tsx scripts/background-worker.ts --queue=LIGHT",
    "worker:heavy": "tsx scripts/background-worker.ts --queue=HEAVY",
    "piecework:publish-v1": "tsx scripts/publish-piecework-price-book-v1.ts",
    "lint": "eslint && node scripts/ui-copy/check.mjs && node scripts/ui-tokens/check.mjs",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:load": "node scripts/load-test.mjs",
    "test:load:seed": "node scripts/load-test-seed.mjs",
    "test:load:preflight": "node scripts/load-test-preflight.mjs",
    "test:worker-ui": "playwright test tests/visual/worker-responsive.spec.ts --workers=4",
    "test:admin-ui": "playwright test tests/visual/admin-responsive.spec.ts --workers=4",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:migrations:fresh": "node scripts/verify-fresh-migrations.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "deploy:smoke": "node scripts/deploy-smoke.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:backup": "node scripts/check-backup-readiness.mjs",
    "check:architecture": "tsx scripts/check-architecture.ts --check",
    "check:dead-code": "node scripts/dead-code-scan.mjs",
    "audit:review-data": "tsx scripts/audit-review-data-integrity.ts",
    "agent:next": "node scripts/agent-next-task.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "lint:ui": "node scripts/ui-copy/check.mjs && node scripts/ui-tokens/check.mjs",
    "lint:ui:baseline": "node scripts/ui-tokens/check.mjs --write-baseline",
    "test:e2e:preflight": "tsx scripts/e2e-preflight.ts",
    "test:e2e:prepare": "tsx scripts/prepare-e2e-catalog.ts && tsx scripts/prepare-e2e-piecework.ts",
    "test:compat": "playwright test --config=playwright.compat.config.ts",
    "test:release": "playwright test --config=playwright.release.config.ts",
    "test:release:dev-fixtures": "playwright test --config=playwright.dev-fixtures.config.ts",
    "test:release:durable": "playwright test --config=playwright.durable.config.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@next/env": "16.3.4",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "@sentry/nextjs": "^10.49.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "ali-oss": "^6.23.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.8.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "prisma": "7.7.0",
    "puppeteer": "^25.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.73.1",
    "recharts": "3.8.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/ali-oss": "^6.23.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "knip": "6.33.0",
    "madge": "8.0.0",
    "pg": "^8.20.0",
    "playwright-core": "^1.59.1",
    "tailwindcss": "^4",
    "ts-prune": "0.10.3",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "protobufjs",
      "@sentry/cli"
    ],
    "patchedDependencies": {
      "@prisma/adapter-pg@7.7.0": "patches/@prisma__adapter-pg@7.7.0.patch"
    },
    "overrides": {
      "@prisma/config>deepmerge-ts": "8.0.0",
      "prisma>mysql2": "3.23.1",
      "@prisma/dev>@hono/node-server": "1.19.15",
      "@prisma/dev>valibot": "1.4.2",
      "@opentelemetry/core@>=2.0.0 <2.8.0": "2.8.0",
      "esbuild@>=0.27.0 <0.28.1": "0.28.1"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.1"
}
