# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/public/load-test/
/output/
/.review/
/.vitest-attachments/
# Vitest Browser Mode 运行时截图产物（无基线比对，勿提交）
**/__tests__/__screenshots__/

# next.js
/.next/
/.next-release/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Prisma 7 rust-free client output (regenerated by `pnpm prisma generate`)
/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Isolated durable-worker browser build
/.next-durable/

/playwright-report-durable/
/test-results-durable/
